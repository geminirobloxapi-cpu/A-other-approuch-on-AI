		)

	if #results == 0 then
		return nil
	end

	return results
end

---------------------------------------------------------------------
-- "WHAT DOES X MEAN?"
---------------------------------------------------------------------

local function parseMeaningQuestion(text)

	local lower =
		string.lower(
			text
		)

	local subject =
		string.match(
			lower,
			"^%s*what%s+does%s+(.+)%s+mean[%?%!%.]*$"
		)

	if not subject then

		subject =
			string.match(
				lower,
				"^%s*what%s+is%s+the%s+meaning%s+of%s+(.+)[%?%!%.]*$"
			)

	end

	if not subject then
		return nil
	end

	return
		normalizeWord(
			subject
		)
end

---------------------------------------------------------------------
-- SINGLE WORD
---------------------------------------------------------------------

local function getSingleWord(text)

	local lower =
		string.lower(
			text
		)

	lower =
		string.gsub(
			lower,
			"[%?%!%.%,]",
			""
		)

	lower =
		cleanText(
			lower
		)

	if lower == "" then
		return nil
	end

	if string.find(
		lower,
		"%s"
		) then

		return nil
	end

	return lower
end

---------------------------------------------------------------------
-- DEFINITION RESPONSE
---------------------------------------------------------------------

local function tryDefinitionResponse(text)

	-------------------------------------------------------------
	-- "what does yo mean?"
	-------------------------------------------------------------

	local requestedWord =
		parseMeaningQuestion(
			text
		)

	if requestedWord then

		local definitions =
			getDefinition(
				requestedWord
			)

		if definitions then

			return
				capitalize(
					requestedWord
				)
				..
				" means "
				..
				joinWords(
					definitions
				)
				..
				"."
		end

		return nil
	end

	-------------------------------------------------------------
	-- JUST:
	-- yo
	-------------------------------------------------------------

	local singleWord =
		getSingleWord(
			text
		)

	if singleWord then

		local definitions =
			getDefinition(
				singleWord
			)

		if definitions then

			if #definitions == 1 then

				return
					capitalize(
						definitions[1]
					)
					..
					"."
			end

			return
				capitalize(
					singleWord
				)
				..
				" means "
				..
				joinWords(
					definitions
				)
				..
				"."
		end
	end

	return nil
end

---------------------------------------------------------------------
-- WHAT IS X?
---------------------------------------------------------------------

local function parseWhatIsQuestion(text)

	local lower =
		string.lower(
			text
		)

	local subject =
		string.match(
			lower,
			"^%s*what%s+is%s+an?%s+(.+)[%?%!%.]*$"
		)

	if not subject then

		subject =
			string.match(
				lower,
				"^%s*what%s+is%s+(.+)[%?%!%.]*$"
			)

	end

	if not subject then
		return nil
	end

	subject =
		string.gsub(
			subject,
			"^an%s+",
			""
		)

	subject =
		string.gsub(
			subject,
			"^a%s+",
			""
		)

	return
		normalizeWord(
			subject
		)
end

---------------------------------------------------------------------
-- WHAT IS RESPONSE
---------------------------------------------------------------------

local function tryWhatIsResponse(text)

	local subject =
		parseWhatIsQuestion(
			text
		)

	if not subject then
		return nil
	end

	-------------------------------------------------------------
	-- IS_A
	-------------------------------------------------------------

	local types =
		getRelationTargets(
			subject,
			"is_a",
			10
		)

	if #types > 0 then

		if #types == 1 then

			return
				capitalize(
					subject
				)
				..
				" is "
				..
				addArticle(
					types[1]
				)
				..
				"."
		end

		return
			capitalize(
				subject
			)
			..
			" is "
			..
			joinWords(
				types
			)
			..
			"."
	end

	-------------------------------------------------------------
	-- MEANS
	-------------------------------------------------------------

	local meanings =
		getDefinition(
			subject
		)

	if meanings then

		return
			capitalize(
				subject
			)
			..
			" means "
			..
			joinWords(
				meanings
			)
			..
			"."
	end

	return nil
end

