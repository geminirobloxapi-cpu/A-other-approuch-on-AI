---------------------------------------------------------------------
-- NUMBER FORMAT
---------------------------------------------------------------------

local function formatNumber(value)

	if math.abs(
		value - math.floor(value)
		) < 0.0000001
	then

		return
			tostring(
				math.floor(value)
			)
	end

	local text =
		string.format(
			"%.6f",
			value
		)

	text =
		string.gsub(
			text,
			"0+$",
			""
		)

	text =
		string.gsub(
			text,
			"%.$",
			""
		)

	return text
end

---------------------------------------------------------------------
-- CALCULATE
---------------------------------------------------------------------

local function calculateExpression(
	a,
	operator,
	b
)

	if operator == "+" then

		return a + b

	elseif operator == "-" then

		return a - b

	elseif operator == "*" then

		return a * b

	elseif operator == "/" then

		if b == 0 then
			return nil
		end

		return a / b

	elseif operator == "%" then

		if b == 0 then
			return nil
		end

		return a % b

	elseif operator == "^" then

		return a ^ b
	end

	return nil
end

---------------------------------------------------------------------
-- NORMALIZE MATH
---------------------------------------------------------------------

local function normalizeMathText(text)

	local lower =
		string.lower(
			tostring(
				text or ""
			)
		)

	-------------------------------------------------------------
	-- 2x2 -> 2 * 2
	-------------------------------------------------------------

	lower =
		string.gsub(
			lower,
			"(%d)%s*[xX]%s*(%d)",
			"%1 * %2"
		)

	-------------------------------------------------------------
	-- QUESTION WORDING
	-------------------------------------------------------------

	lower =
		string.gsub(
			lower,
			"what%s+is",
			" "
		)

	lower =
		string.gsub(
			lower,
			"what's",
			" "
		)

	lower =
		string.gsub(
			lower,
			"whats",
			" "
		)

	lower =
		string.gsub(
			lower,
			"calculate",
			" "
		)

	lower =
		string.gsub(
			lower,
			"solve",
			" "
		)

	-------------------------------------------------------------
	-- OPERATORS
	-------------------------------------------------------------

	lower =
		string.gsub(
			lower,
			"%s+plus%s+",
			" + "
		)

	lower =
		string.gsub(
			lower,
			"%s+add%s+",
			" + "
		)

	lower =
		string.gsub(
			lower,
			"%s+minus%s+",
			" - "
		)

	lower =
		string.gsub(
			lower,
			"%s+subtract%s+",
			" - "
		)

	lower =
		string.gsub(
			lower,
			"%s+times%s+",
			" * "
		)

	lower =
		string.gsub(
			lower,
			"%s+multiplied%s+by%s+",
			" * "
		)

	lower =
		string.gsub(
			lower,
			"%s+divide%s+",
			" / "
		)

	lower =
		string.gsub(
			lower,
			"%s+divided%s+by%s+",
			" / "
		)

	lower =
		string.gsub(
			lower,
			"%s+",
			" "
		)

	lower =
		string.gsub(
			lower,
			"^%s+",
			""
		)

	lower =
		string.gsub(
			lower,
			"%s+$",
			""
		)

	return lower
end

---------------------------------------------------------------------
-- DIRECT MATH
---------------------------------------------------------------------

local function solveMath(text)

	local expression =
		normalizeMathText(
			text
		)

	local aText,
		operator,
		bText =
		string.match(
			expression,
			"^([%-]?[%d%.]+)%s*([%+%-%*/%%%^])%s*([%-]?[%d%.]+)[%?%!%.]*$"
		)

	if not aText
		or not operator
		or not bText
	then

		return nil
	end

	local a =
		tonumber(
			aText
		)

	local b =
		tonumber(
			bText
		)

	if not a
		or not b
	then

		return nil
	end

	if
		(operator == "/"
			or operator == "%")
		and b == 0
	then

		return
			"I can't divide by zero."
	end

	local result =
		calculateExpression(
			a,
			operator,
			b
		)

	if result == nil then
		return nil
	end

	return
		formatNumber(a)
		..
		" "
		..
		operator
		..
		" "
		..
		formatNumber(b)
		..
		" = "
		..
		formatNumber(result)
		..
		"."
end

---------------------------------------------------------------------
-- SPLIT TARGETS
---------------------------------------------------------------------

local function splitTargets(text)

	local results = {}

	text =
		string.gsub(
			text,
			"%s+and%s+",
			","
		)

	for item in
		string.gmatch(
			text,
			"[^,]+"
		)
	do

		item =
			normalizeWord(
				item
			)

		if item ~= "" then

			table.insert(
				results,
				item
			)

		end
	end

	return results
end

---------------------------------------------------------------------
-- EXTRACT "MEANS"
---------------------------------------------------------------------

local function extractMeansRelation(text)

	local lower =
		string.lower(
			text
		)

	local subject,
		targetText =
		string.match(
			lower,
			"^%s*(.-)%s+means%s+(.+)%s*$"
		)

	if not subject
		or not targetText
	then

		return nil
	end

	subject =
		normalizeWord(
			subject
		)

	targetText =
		string.gsub(
			targetText,
			"[%?%!%.]+$",
			""
		)

	local targets =
		splitTargets(
			targetText
		)

	if subject == ""
		or #targets == 0
	then

		return nil
	end

	return {

		subject =
			subject,

		relation =
			"means",

		targets =
			targets
	}
end

---------------------------------------------------------------------
-- EXTRACT "IS A / IS AN"
--
-- a dog is a animal
-- dog is an animal
-- roblox is a game
--
-- Leading "a/an/the" is removed from subject.
---------------------------------------------------------------------

local function extractIsARelation(text)

	local lower =
		string.lower(
			text
		)

	local subject,
		target =
		string.match(
			lower,
			"^%s*(.-)%s+is%s+an?%s+(.+)%s*$"
		)

	if not subject
		or not target
	then

		return nil
	end

	-------------------------------------------------------------
	-- REMOVE LEADING ARTICLES FROM SUBJECT
	-------------------------------------------------------------

	subject =
		string.gsub(
			subject,
			"^%s*an%s+",
			""
		)

	subject =
		string.gsub(
			subject,
			"^%s*a%s+",
			""
		)

	subject =
		string.gsub(
			subject,
			"^%s*the%s+",
			""
		)

	subject =
		normalizeWord(
			subject
		)

	target =
		normalizeWord(
			target
		)

	if subject == ""
		or target == ""
	then

		return nil
	end

	return {

		subject =
			subject,

		relation =
			"is_a",

		targets = {
			target
		}
	}
end

---------------------------------------------------------------------
-- LEARN STRUCTURED FACT
---------------------------------------------------------------------

local function learnStructuredFact(text)

	-------------------------------------------------------------
	-- FIRST:
	-- yo means hello
	-------------------------------------------------------------

	local fact =
		extractMeansRelation(
			text
		)

	-------------------------------------------------------------
	-- SECOND:
	-- dog is an animal
	-------------------------------------------------------------

	if not fact then

		fact =
			extractIsARelation(
				text
			)

	end

	if not fact then
		return nil
	end

	for _, target
		in ipairs(
			fact.targets
		)
	do

		safeCall(
			"Memory.LearnRelation",
			Memory.LearnRelation,
			fact.subject,
			fact.relation,
			target,
			2
		)

		---------------------------------------------------------
		-- MILD ASSOCIATION
		---------------------------------------------------------

		if Memory.Associate then

			safeCall(
				"Memory.Associate",
				Memory.Associate,
				fact.subject,
				target,
				0.2
			)

		end
	end

	return fact
end

---------------------------------------------------------------------
-- JOIN WORDS
---------------------------------------------------------------------

local function joinWords(words)

	if #words == 0 then
		return ""
	end

	if #words == 1 then
		return words[1]
	end

	if #words == 2 then

		return
			words[1]
			..
			" and "
			..
			words[2]
	end

	local parts = {}

	for i, word
		in ipairs(words)
	do

		if i == #words then

			table.insert(
				parts,
				"and " .. word
			)

		else

			table.insert(
				parts,
				word
			)

		end
	end

	return
		table.concat(
			parts,
			", "
		)
end

---------------------------------------------------------------------
-- LOOK UP RELATION TARGETS
---------------------------------------------------------------------

local function getRelationTargets(
	subject,
	relation,
	limit
)

	subject =
		normalizeWord(
			subject
		)

	local results =
		safeCall(
			"Memory.GetRelations",
			Memory.GetRelations,
			subject,
			relation,
			limit or 10
		)
		or {}

	local targets = {}

	for _, item
		in ipairs(results)
	do

		local target =
			item.target
			or item.word
			or item.key

		if target then

			table.insert(
				targets,
				target
			)

		end
	end

	return targets
end

