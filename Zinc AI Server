---------------------------------------------------------------------
-- SAFE CALL
---------------------------------------------------------------------

local function safeCall(
	name,
	callback,
	...
)

	if typeof(callback)
		~= "function"
	then

		return nil
	end

	local args = {...}

	local ok, result =
		pcall(
			function()

				return
				callback(
					table.unpack(
						args
					)
				)

			end
		)

	if not ok then

		warn(
			"[BRAIN]",
			name,
			"failed:",
			result
		)

		return nil
	end

	return result
end

---------------------------------------------------------------------
-- CLEAN TEXT
---------------------------------------------------------------------

local function cleanText(text)

	if typeof(text)
		~= "string"
	then

		return ""
	end

	text =
		string.gsub(
			text,
			"[%c]",
			" "
		)

	text =
		string.gsub(
			text,
			"%s+",
			" "
		)

	text =
		string.gsub(
			text,
			"^%s+",
			""
		)

	text =
		string.gsub(
			text,
			"%s+$",
			""
		)

	if #text > MAX_MESSAGE_LENGTH then

		text =
			string.sub(
				text,
				1,
				MAX_MESSAGE_LENGTH
			)

	end

	return text
end

---------------------------------------------------------------------
-- NORMALIZE WORD
---------------------------------------------------------------------

local function normalizeWord(word)

	word =
		string.lower(
			tostring(
				word or ""
			)
		)

	word =
		string.gsub(
			word,
			"^%s+",
			""
		)

	word =
		string.gsub(
			word,
			"%s+$",
			""
		)

	word =
		string.gsub(
			word,
			"^[%p]+",
			""
		)

	word =
		string.gsub(
			word,
			"[%p]+$",
			""
		)

	return word
end

---------------------------------------------------------------------
-- CAPITALIZE
---------------------------------------------------------------------

local function capitalize(text)

	text =
		tostring(
			text or ""
		)

	if text == "" then
		return ""
	end

	return
		string.upper(
			string.sub(
				text,
				1,
				1
			)
		)
		..
		string.sub(
			text,
			2
		)
end

---------------------------------------------------------------------
-- ARTICLE
--
-- animal -> an animal
-- dog -> a dog
---------------------------------------------------------------------

local function addArticle(word)

	word =
		tostring(
			word or ""
		)

	local first =
		string.lower(
			string.sub(
				word,
				1,
				1
			)
		)

	if first == "a"
		or first == "e"
		or first == "i"
		or first == "o"
		or first == "u"
	then

		return
			"an "
			..
			word
	end

	return
		"a "
		..
		word
end

