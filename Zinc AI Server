---------------------------------------------------------------------
-- VALID RELATIONS
---------------------------------------------------------------------

local ALLOWED_RELATIONS = {

	means = true,
	is_a = true,

	has = true,
	can_do = true,
	likes = true,

	part_of = true,
	used_for = true,
	located_in = true,
	causes = true
}

---------------------------------------------------------------------
-- TRAIN GEMINI FACTS
---------------------------------------------------------------------

local function trainFacts(text)

	if typeof(text)
		~= "string"
	then

		return 0
	end

	if string.upper(
		cleanText(text)
		) == "NONE"
	then

		return 0
	end

	local count = 0

	for line in
		string.gmatch(
			text,
			"[^\r\n]+"
		)
	do

		local subject,
			relation,
			target =
			string.match(
				line,
				"^([^|]+)|([^|]+)|([^|]+)$"
			)

		if subject
			and relation
			and target
		then

			subject =
				normalizeWord(
					subject
				)

			relation =
				normalizeWord(
					relation
				)

			target =
				normalizeWord(
					target
				)

			if subject ~= ""
				and target ~= ""
				and ALLOWED_RELATIONS[
				relation
				]
			then

				safeCall(
					"Memory.LearnRelation",
					Memory.LearnRelation,
					subject,
					relation,
					target,
					1
				)

				count += 1

				print(
					"[GEMINI FACT]",
					subject,
					"--"
						..
						relation
						..
						"-->",
					target
				)

			end
		end
	end

	return count
end

---------------------------------------------------------------------
-- TRAIN NEURAL EXAMPLES
---------------------------------------------------------------------

local function trainNeuralExamples(text)

	if typeof(text) ~= "string" then
		return 0
	end

	if not Neurons.Train then
		return 0
	end

	local trained = 0

	for line in string.gmatch(text, "[^\r\n]+") do

		local inputText, expectedText =
			string.match(
				line,
				"^([^|]+)|([^|]+)$"
			)

		if inputText and expectedText then

			inputText = cleanText(inputText)
			expectedText = cleanText(expectedText)

			if inputText ~= ""
				and expectedText ~= ""
			then

				local expectedWords =
					Dictionary.Tokenize(expectedText)

				if typeof(expectedWords) == "table"
					and #expectedWords > 0
				then

					local context = inputText
					local sequenceTargets = table.clone(expectedWords)

					-- Teach an explicit ending so generation knows when to stop.
					table.insert(
						sequenceTargets,
						RESPONSE_END_TOKEN
					)

					for _, targetWord in ipairs(sequenceTargets) do

						local inputVector =
							safeCall(
								"Dictionary.TextToVector",
								Dictionary.TextToVector,
								context
							)

						local targetVector =
							safeCall(
								"Dictionary.TextToVector",
								Dictionary.TextToVector,
								targetWord
							)

						if typeof(inputVector) == "table"
							and typeof(targetVector) == "table"
						then

							-- Repetition gives this small local model enough
							-- gradient signal to learn the next-token mapping.
							for _ = 1, 12 do

								safeCall(
									"Neurons.Train",
									Neurons.Train,
									inputVector,
									targetVector,
									0.012
								)
							end

							print(
								"[NEURAL NEXT-TOKEN TRAIN]",
								context,
								"->",
								targetWord
							)
						end

						if targetWord ~= RESPONSE_END_TOKEN then
							context =
								context
								..
								" "
								..
								targetWord
						end
					end

					trained += 1
				end
			end
		end
	end

	return trained
end

---------------------------------------------------------------------
-- RUN GEMINI TEACHER
--
-- IMPORTANT:
-- Missing key is checked ONCE.
-- We do NOT print missing-key warning 3 times.
---------------------------------------------------------------------

local function runGeminiTeacher(
	text,
	internetContext
)

	if not GEMINI_ENABLED then

		return {
			interpretation = "",
			facts = "",
			training = ""
		}
	end

	-----------------------------------------------------------------
	-- KEY CHECK ONCE
	-----------------------------------------------------------------

	if not getGeminiAPIKey() then

		print(
			"[GEMINI] Teacher disabled - ServerStorage.GeminiAPIKey missing."
		)

		return {
			interpretation = "",
			facts = "",
			training = ""
		}
	end

	if not canUseGemini() then

		return {
			interpretation = "",
			facts = "",
			training = ""
		}
	end

	local requestCount = 0

	-----------------------------------------------------------------
	-- REQUEST 1:
	-- UNDERSTAND USER
	-----------------------------------------------------------------

	local interpretation = ""

	if requestCount
		< MAX_GEMINI_REQUESTS
	then

		interpretation =
			getGeminiInterpretation(
				text
			)
			or ""

		requestCount += 1
	end

	-----------------------------------------------------------------
	-- BUILD FACT CONTEXT
	-----------------------------------------------------------------

	local context =
		interpretation

	if internetContext
		and internetContext.extract
	then

		context =
			context
			..
			"\n\nINTERNET INFORMATION:\n"
			..
			internetContext.extract
	end

	-----------------------------------------------------------------
	-- REQUEST 2:
	-- FACTS
	-----------------------------------------------------------------

	local facts =
		"NONE"

	if requestCount
		< MAX_GEMINI_REQUESTS
	then

		facts =
			getGeminiFacts(
				text,
				context
			)
			or "NONE"

		requestCount += 1
	end

	local factCount =
		trainFacts(
			facts
		)

	-----------------------------------------------------------------
	-- REQUEST 3:
	-- NEURAL TRAINING
	-----------------------------------------------------------------

	local training = ""

	if requestCount
		< MAX_GEMINI_REQUESTS
	then

		training =
			getGeminiTraining(
				text,
				interpretation,
				facts
			)
			or ""

		requestCount += 1
	end

	local exampleCount =
		trainNeuralExamples(
			training
		)

	print(
		"[GEMINI TEACHER]",
		"requests:",
		requestCount,
		"facts:",
		factCount,
		"examples:",
		exampleCount
	)

	if interpretation ~= "" then

		print(
			"[GEMINI MEANING]",
			interpretation
		)

	end

	return {

		interpretation =
			interpretation,

		facts =
			facts,

		training =
			training
	}
end

