-- REMOTE
---------------------------------------------------------------------

Remote.OnServerInvoke =
	function(player, text)

		if playerBusy[player] then

			return
			"I'm already thinking."
		end

		playerBusy[player] =
		true

		local ok, result =
		pcall(
			function()

				return
				handleUserMessage(
					player,
					text
				)

			end
		)

		playerBusy[player] =
		nil

		if not ok then

			warn(
				"[BRAIN ERROR]",
				result
			)

			return
			"SERVER ERROR: "
			..
			tostring(
				result
			)
		end

		return result
	end

