local function getNeuralWords(vector)

	if Dictionary.VectorToTopWords then

		return
			safeCall(
				"Dictionary.VectorToTopWords",
				Dictionary.VectorToTopWords,
				vector,
				10
			)
			or {}
	end

	return {}
end

---------------------------------------------------------------------
-- PRIMARY WORD
---------------------------------------------------------------------

local function findPrimaryWord(
	neuralWords,
	wmState
)

	local current =
		safeCall(
			"WorkingMemory.GetCurrentWords",
			WorkingMemory.GetCurrentWords
		)
		or {}

	if typeof(current)
		== "table"
	then

		for i = #current, 1, -1 do

			local word =
				normalizeWord(
					current[i]
				)

			if word ~= ""
				and not LEARNING_STOP_WORDS[word]
				and not tonumber(word)
			then

				return word
			end
		end
	end

	if wmState
		and wmState.topic
	then

		local topic =
			normalizeWord(
				wmState.topic
			)

		if topic ~= ""
			and not LEARNING_STOP_WORDS[topic]
		then

			return topic
		end
	end

	for _, item
		in ipairs(neuralWords)
	do

		local word

		if typeof(item)
			== "table"
		then

			word =
				item.word
				or item.key

		else

			word =
				item
		end

		word =
			normalizeWord(
				word
			)

		if word ~= ""
			and not LEARNING_STOP_WORDS[word]
		then

			return word
		end
	end

	return nil
end

---------------------------------------------------------------------
-- ASSOCIATIONS
---------------------------------------------------------------------

local function getAssociationWords(word)

	if not word then
		return {}
	end

	local results = {}
	local used = {}

	local associations =
		safeCall(
			"Memory.GetAssociations",
			Memory.GetAssociations,
			word,
			5
		)
		or {}

	for _, entry
		in ipairs(
			associations
		)
	do

		local target =
			normalizeWord(
				entry.word
				or entry.key
			)

		if target ~= ""
			and not used[target]
			and not LEARNING_STOP_WORDS[target]
		then

			used[target] =
				true

			table.insert(
				results,
				target
			)

		end
	end

	return results
end

---------------------------------------------------------------------
-- NEXT-WORD NEURAL RESPONSE DECODER
--
-- The old decoder took ONE output vector and grabbed the four nearest
-- dictionary words. That produced responses such as:
--     "Plant time their nice"
--
-- This decoder predicts ONE word, appends that word to the context,
-- then predicts the next word. This preserves sequence generation.
---------------------------------------------------------------------

local RESPONSE_END_TOKEN = "responseend"
local MAX_GENERATED_WORDS = 14
local MIN_NEXT_WORD_SCORE = 0.20

local function decodeNextWord(neuralVector)

	if typeof(neuralVector) ~= "table" then
		return nil, nil
	end

	if Dictionary.VectorToScoredWords then

		local scored =
			safeCall(
				"Dictionary.VectorToScoredWords",
				Dictionary.VectorToScoredWords,
				neuralVector,
				5
			)
			or {}

		for _, item in ipairs(scored) do

			local word =
				normalizeWord(
					item.word
					or item.key
					or item.text
				)

			local score =
				tonumber(
					item.score
					or item.similarity
					or item.weight
				)

			if word ~= ""
				and not tonumber(word)
			then
				return word, score
			end
		end
	end

	if Dictionary.VectorToTopWords then

		local words =
			safeCall(
				"Dictionary.VectorToTopWords",
				Dictionary.VectorToTopWords,
				neuralVector,
				1
			)
			or {}

		if words[1] then
			return normalizeWord(words[1]), nil
		end
	end

	return nil, nil
end

local function generateNeuralResponse(
	brainInput,
	wmState
)

	local _ = wmState

	-- A brand-new random network should NOT talk.
	-- Allow prediction even if the network has not been trained yet.
	-- Warning: an untrained network may output random words.

--[[
if Neurons.IsTrained
	and not Neurons.IsTrained()
then
	print(
		"[NEURAL RESPONSE] Network has not been trained yet."
	)

	return ""
end
]]

	local context =
		cleanText(
			brainInput
		)

	if context == "" then
		return nil
	end

	local generated = {}
	local repeated = {}

	for step = 1, MAX_GENERATED_WORDS do

		local inputVector =
			safeCall(
				"Dictionary.TextToVector",
				Dictionary.TextToVector,
				context
			)

		if typeof(inputVector) ~= "table" then
			break
		end

		local outputVector =
			safeCall(
				"Neurons.Predict",
				Neurons.Predict,
				inputVector
			)

		if typeof(outputVector) ~= "table" then
			break
		end

		local nextWord, score =
			decodeNextWord(
				outputVector
			)

		if not nextWord
			or nextWord == ""
		then
			break
		end

		print(
			"[NEXT WORD]",
			step,
			nextWord,
			"score:",
			tostring(score)
		)

		if nextWord == RESPONSE_END_TOKEN then
			break
		end

		if score ~= nil
			and score < MIN_NEXT_WORD_SCORE
		then
			print(
				"[NEXT WORD] confidence too low; stopping."
			)
			break
		end

		repeated[nextWord] =
			(repeated[nextWord] or 0)
			+ 1

		if repeated[nextWord] > 2 then
			print(
				"[NEXT WORD] repetition limit reached; stopping."
			)
			break
		end

		table.insert(
			generated,
			nextWord
		)

		context =
			context
			..
			" "
			..
			nextWord
	end

	if #generated == 0 then
		return nil
	end

	return
		capitalize(
			table.concat(
				generated,
				" "
			)
		)
end

---------------------------------------------------------------------
-- NORMAL WORD LEARNING
---------------------------------------------------------------------

local function learnNormalMessage()

	local words =
		safeCall(
			"WorkingMemory.GetCurrentWords",
			WorkingMemory.GetCurrentWords
		)

	if typeof(words)
		~= "table"
	then

		return
	end

	local filtered = {}

	for _, word
		in ipairs(words)
	do

		word =
			normalizeWord(
				word
			)

		if word ~= ""
			and not LEARNING_STOP_WORDS[word]
			and not tonumber(word)
		then

			table.insert(
				filtered,
				word
			)

		end
	end

	for _, word
		in ipairs(filtered)
	do

		safeCall(
			"Memory.ReinforcePattern",
			Memory.ReinforcePattern,
			word,
			0.2
		)

	end

	for i = 1, #filtered do

		for j =
			i + 1,
			math.min(
				#filtered,
				i + 2
			)
		do

			if filtered[i]
				~= filtered[j]
			then

				safeCall(
					"Memory.AssociateBoth",
					Memory.AssociateBoth,
					filtered[i],
					filtered[j],
					0.1
				)

			end
		end
	end
end

---------------------------------------------------------------------
-- GEMINI RATE LIMIT
---------------------------------------------------------------------

local function canUseGemini()

	if not GEMINI_ENABLED then
		return false
	end

	if GeminiLocked then

		if os.time()
			>= GeminiUnlockTime
		then

			GeminiLocked = false
			GeminiUnlockTime = 0

		else

			return false
		end
	end

	return true
end

local function lockGemini(seconds)

	seconds =
		math.max(
			1,
			tonumber(seconds)
			or 5
		)

	GeminiLocked = true

	GeminiUnlockTime =
		os.time()
		+
		seconds
end

---------------------------------------------------------------------
-- GEMINI REQUEST
---------------------------------------------------------------------

local function callGemini(
	systemPrompt,
	userPrompt
)

	if not canUseGemini() then
		return nil
	end

	local key =
		getGeminiAPIKey()

	if not key then
		return nil
	end

	local url =
		GEMINI_API_BASE
		..
		GEMINI_MODEL
		..
		":generateContent?key="
		..
		key

	local body = {

		contents = {

			{
				role =
					"user",

				parts = {

					{
						text =
							"SYSTEM INSTRUCTION:\n"
							..
							systemPrompt
					}
				}
			},

			{
				role =
					"user",

				parts = {

					{
						text =
							userPrompt
					}
				}
			}
		}
	}

	local success,
		response =
		pcall(
			function()

				return
				HttpService:RequestAsync(
					{
						Url =
						url,

						Method =
						"POST",

						Headers = {

							["Content-Type"] =
							"application/json"
						},

						Body =
						HttpService:JSONEncode(
							body
						)
					}
				)

			end
		)

	if not success
		or not response
	then

		warn(
			"[GEMINI] Request failed."
		)

		return nil
	end

	if response.StatusCode == 429 then

		local retry =
			tonumber(
				response.Headers
				and response.Headers["retry-after"]
			)
			or 5

		lockGemini(
			math.min(
				retry,
				60
			)
		)

		warn(
			"[GEMINI] Rate limited."
		)

		return nil
	end

	if not response.Success then

		warn(
			"[GEMINI HTTP]",
			response.StatusCode,
			response.Body
		)

		return nil
	end

	local decoded

	local decodeOK =
		pcall(
			function()

				decoded =
				HttpService:JSONDecode(
					response.Body
				)

			end
		)

	if not decodeOK then
		return nil
	end

	local text =
		decoded
		and decoded.candidates
		and decoded.candidates[1]
		and decoded.candidates[1].content
		and decoded.candidates[1].content.parts
		and decoded.candidates[1].content.parts[1]
		and decoded.candidates[1].content.parts[1].text

	if typeof(text)
		~= "string"
	then

		return nil
	end

	return
		cleanText(
			text
		)
end

