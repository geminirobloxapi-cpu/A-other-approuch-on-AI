local function internetRequest(url)

	if not INTERNET_ENABLED then
		return nil
	end

	local success,
		response =
		pcall(
			function()

				return
				HttpService:RequestAsync(
					{
						Url =
						url,

						Method =
						"GET",

						Headers = {

							["Accept"] =
							"application/json",

							["User-Agent"] =
							"ZINC-Brain/1.0"
						}
					}
				)

			end
		)

	if not success
		or not response
	then

		warn(
			"[INTERNET] Request failed."
		)

		return nil
	end

	if not response.Success then

		warn(
			"[INTERNET HTTP]",
			response.StatusCode
		)

		return nil
	end

	return response
end

---------------------------------------------------------------------
-- WIKIPEDIA SEARCH
---------------------------------------------------------------------

local function searchWikipedia(
	query,
	limit
)

	limit =
		math.clamp(
			tonumber(limit)
			or 3,
			1,
			5
		)

	local url =
		WIKIPEDIA_SEARCH_URL
		..
		"?q="
		..
		HttpService:UrlEncode(
			query
		)
		..
		"&limit="
		..
		tostring(
			limit
		)

	local response =
		internetRequest(
			url
		)

	if not response then
		return {}
	end

	local decoded

	local success =
		pcall(
			function()

				decoded =
				HttpService:JSONDecode(
					response.Body
				)

			end
		)

	if not success
		or typeof(decoded)
		~= "table"
		or typeof(decoded.pages)
		~= "table"
	then

		return {}
	end

	return decoded.pages
end

---------------------------------------------------------------------
-- WIKIPEDIA SUMMARY
---------------------------------------------------------------------

local function getWikipediaSummary(title)

	local url =
		WIKIPEDIA_SUMMARY_URL
		..
		HttpService:UrlEncode(
			title
		)

	local response =
		internetRequest(
			url
		)

	if not response then
		return nil
	end

	local decoded

	local success =
		pcall(
			function()

				decoded =
				HttpService:JSONDecode(
					response.Body
				)

			end
		)

	if not success
		or typeof(decoded)
		~= "table"
	then

		return nil
	end

	if typeof(decoded.extract)
		~= "string"
	then

		return nil
	end

	return {

		title =
			decoded.title,

		description =
			decoded.description,

		extract =
			decoded.extract
	}
end

---------------------------------------------------------------------
-- INTERNET LOOKUP
---------------------------------------------------------------------

local function internetLookup(query)

	if not INTERNET_ENABLED then
		return nil
	end

	local pages =
		searchWikipedia(
			query,
			3
		)

	if #pages == 0 then
		return nil
	end

	for _, page
		in ipairs(pages)
	do

		if page.title then

			local summary =
				getWikipediaSummary(
					page.title
				)

			if summary then

				print(
					"[INTERNET RESULT]",
					summary.title
				)

				return summary
			end
		end
	end

	return nil
end

---------------------------------------------------------------------
-- SHOULD USE INTERNET?
---------------------------------------------------------------------

local function shouldUseInternet(text)

	local lower =
		string.lower(
			text
		)

	if string.match(
		lower,
		"^%s*what%s+is%s+"
		) then

		return true
	end

	if string.match(
		lower,
		"^%s*who%s+is%s+"
		) then

		return true
	end

	if string.match(
		lower,
		"^%s*what%s+are%s+"
		) then

		return true
	end

	if string.match(
		lower,
		"^%s*where%s+is%s+"
		) then

		return true
	end

	if string.match(
		lower,
		"^%s*tell%s+me%s+about%s+"
		) then

		return true
	end

	return false
end

---------------------------------------------------------------------
-- EXTRACT SEARCH TERM
---------------------------------------------------------------------

local function extractSearchTerm(text)

	local lower =
		string.lower(
			text
		)

	local subject =
		string.match(
			lower,
			"^%s*what%s+is%s+an?%s+(.+)"
		)

	if not subject then

		subject =
			string.match(
				lower,
				"^%s*what%s+is%s+(.+)"
			)

	end

	if not subject then

		subject =
			string.match(
				lower,
				"^%s*what%s+are%s+(.+)"
			)

	end

	if not subject then

		subject =
			string.match(
				lower,
				"^%s*who%s+is%s+(.+)"
			)

	end

	if not subject then

		subject =
			string.match(
				lower,
				"^%s*where%s+is%s+(.+)"
			)

	end

	if not subject then

		subject =
			string.match(
				lower,
				"^%s*tell%s+me%s+about%s+(.+)"
			)

	end

	if not subject then
		subject = text
	end

	subject =
		string.gsub(
			subject,
			"[%?%!%.]+$",
			""
		)

	return
		cleanText(
			subject
		)
end

---------------------------------------------------------------------
-- INTERNET RESPONSE
---------------------------------------------------------------------

local function buildInternetResponse(result)

	if not result
		or not result.extract
	then

		return nil
	end

	local text =
		result.extract

	-------------------------------------------------------------
	-- DON'T SEND A GIANT WIKIPEDIA ARTICLE
	-------------------------------------------------------------

	if #text > 500 then

		text =
			string.sub(
				text,
				1,
				500
			)

		local shorter =
			string.match(
				text,
				"^(.*[%p])"
			)

		if shorter
			and #shorter > 50
		then

			text = shorter

		else

			text =
				text
				..
				"..."
		end
	end

	return text
end

---------------------------------------------------------------------
-- LOCAL KNOWLEDGE CONTEXT
--
-- This section deliberately DOES NOT return an answer.
-- Learned facts are appended to the neural input instead so the
-- network gets to decide what response vector to produce.
---------------------------------------------------------------------

local function buildLocalKnowledgeContext(text)

	local pieces = {}
	local used = {}

	local function addPiece(value)

		value =
			cleanText(
				tostring(value or "")
			)

		if value ~= ""
			and not used[value]
		then
			used[value] = true
			table.insert(pieces, value)
		end
	end

	-------------------------------------------------------------
	-- Meaning question: "what does yo mean?"
	-------------------------------------------------------------

	local meaningSubject =
		parseMeaningQuestion(
			text
		)

	if meaningSubject then

		addPiece(meaningSubject)

		local definitions =
			getDefinition(
				meaningSubject
			)

		if definitions then
			for _, definition in ipairs(definitions) do
				addPiece(definition)
			end
		end
	end

	-------------------------------------------------------------
	-- "what is dog?"
	-------------------------------------------------------------

	local whatIsSubject =
		parseWhatIsQuestion(
			text
		)

	if whatIsSubject then

		addPiece(whatIsSubject)

		local types =
			getRelationTargets(
				whatIsSubject,
				"is_a",
				10
			)

		for _, typeWord in ipairs(types) do
			addPiece(typeWord)
		end

		local meanings =
			getDefinition(
				whatIsSubject
			)

		if meanings then
			for _, meaning in ipairs(meanings) do
				addPiece(meaning)
			end
		end
	end

	-------------------------------------------------------------
	-- A single learned word such as "yo" can still provide its
	-- meaning to the neural network without hardcoding a reply.
	-------------------------------------------------------------

	local singleWord =
		getSingleWord(
			text
		)

	if singleWord then

		local definitions =
			getDefinition(
				singleWord
			)

		if definitions then
			addPiece(singleWord)

			for _, definition in ipairs(definitions) do
				addPiece(definition)
			end
		end
	end

	if #pieces == 0 then
		return ""
	end

	return table.concat(pieces, " ")
end

---------------------------------------------------------------------
-- RUN TEACHER SAFELY
--
-- Teacher is optional.
-- We run it without blocking local learning where possible.
---------------------------------------------------------------------

local function teachAsync(
	text,
	internetContext
)

	if not GEMINI_ENABLED then
		return
	end

	if not getGeminiAPIKey() then
		return
	end

	task.spawn(
		function()

			runGeminiTeacher(
				text,
				internetContext
			)

			saveBrain(false)

		end
	)
end

---------------------------------------------------------------------
-- HANDLE
---------------------------------------------------------------------

local function handleUserMessage(
	player,
	text
)

	text =
		cleanText(
			text
		)

	if text == "" then
		return nil
	end

	print(
		"[BRAIN]",
		player.Name,
		">",
		text
	)

	-----------------------------------------------------------------
	-- LANGUAGE PARSING
	-----------------------------------------------------------------

	local parsed =
		safeCall(
			"Language.Parse",
			Language.Parse,
			text
		)
		or {
			intent = "statement",
			normalized = string.lower(text),
			contentWords = {}
		}

	print(
		"[LANGUAGE]",
		"intent:",
		parsed.intent,
		"subject:",
		tostring(parsed.subject),
		"relation:",
		tostring(parsed.relation)
	)

	-----------------------------------------------------------------
	-- USER WORKING MEMORY
	-----------------------------------------------------------------

	safeCall(
		"WorkingMemory.UpdateUser",
		WorkingMemory.UpdateUser,
		text
	)

	-----------------------------------------------------------------
	-- EMOTION
	-----------------------------------------------------------------

	safeCall(
		"Emotion.UpdateFromText",
		Emotion.UpdateFromText,
		text
	)

	safeCall(
		"Emotion.Decay",
		Emotion.Decay,
		0.1
	)

	-----------------------------------------------------------------
	-- DIRECT MATH
	--
	-- Math stays deterministic because it is a calculator operation,
	-- not a canned conversational fallback.
	-----------------------------------------------------------------

	local mathAnswer =
		solveMath(
			text
		)

	if mathAnswer then

		safeCall(
			"WorkingMemory.UpdateAI",
			WorkingMemory.UpdateAI,
			mathAnswer
		)

		teachAsync(
			text,
			nil
		)

		print(
			"[BRAIN RESPONSE]",
			mathAnswer
		)

		return mathAnswer
	end

	-----------------------------------------------------------------
	-- LEARN LOCAL STRUCTURED FACTS
	--
	-- IMPORTANT: we DO NOT immediately respond with "I understand"
	-- or another prewritten sentence. The information is learned and
	-- then supplied to the neural network as context.
	-----------------------------------------------------------------

	local learnedFact =
		learnStructuredFact(
			text
		)

	-----------------------------------------------------------------
	-- EXTENDED LANGUAGE FACTS
	-- Covers has/can_do/likes/part_of/used_for/located_in/causes.
	-----------------------------------------------------------------

	if not learnedFact and Language.ExtractFact then
		local languageFact =
			safeCall(
				"Language.ExtractFact",
				Language.ExtractFact,
				text
			)

		if languageFact
			and languageFact.subject
			and languageFact.relation
			and typeof(languageFact.targets) == "table"
		then
			for _, target in ipairs(languageFact.targets) do
				safeCall(
					"Memory.LearnRelation",
					Memory.LearnRelation,
					languageFact.subject,
					languageFact.relation,
					target,
					2
				)

				if Memory.Associate then
					safeCall(
						"Memory.Associate",
						Memory.Associate,
						languageFact.subject,
						target,
						0.2
					)
				end
			end

			learnedFact = languageFact
		end
	end

	if learnedFact then
		print(
			"[LOCAL FACT LEARNED]",
			learnedFact.subject,
			learnedFact.relation,
			table.concat(learnedFact.targets, ", ")
		)
	end

	-----------------------------------------------------------------
	-- KNOWLEDGE MODULE
	-----------------------------------------------------------------

	safeCall(
		"Knowledge.InferMeaning",
		Knowledge.InferMeaning,
		text
	)

	-----------------------------------------------------------------
	-- THINKING PLAN + LOCAL KNOWLEDGE PREVIEW
	-----------------------------------------------------------------

	local localKnowledgePreview =
		buildLocalKnowledgeContext(
			text
		)

	local thoughtPlan =
		safeCall(
			"Thinking.Plan",
			Thinking.Plan,
			parsed,
			{
				hasLocalKnowledge = localKnowledgePreview ~= "",
				internetEnabled = INTERNET_ENABLED
			}
		)
		or {
			useInternet = shouldUseInternet(text),
			searchTerm = extractSearchTerm(text),
			intent = parsed.intent
		}

	print(
		"[THINKING]",
		"reason:",
		tostring(thoughtPlan.reason),
		"internet:",
		tostring(thoughtPlan.useInternet)
	)

	-----------------------------------------------------------------
	-- INTERNET RESEARCH
	-- Internet is used only when the thinking plan says local
	-- knowledge is insufficient for a factual question.
	-----------------------------------------------------------------

	local internetResult = nil

	if Thinking.ShouldUseInternet(thoughtPlan) then

		local searchTerm =
			thoughtPlan.searchTerm
			or (Language.ExtractSearchTerm and Language.ExtractSearchTerm(parsed))
			or extractSearchTerm(text)

		print(
			"[INTERNET SEARCH]",
			searchTerm
		)

		internetResult =
			internetLookup(
				searchTerm
			)
	end

	-----------------------------------------------------------------
	-- GEMINI TEACHER
	--
	-- Gemini ONLY teaches:
	--   1. interpretation
	--   2. factual relations
	--   3. neural examples
	--
	-- Gemini NEVER writes the returned response.
	-----------------------------------------------------------------

	local teacherData = {
		interpretation = "",
		facts = "",
		training = ""
	}

	if getGeminiAPIKey()
		and canUseGemini()
	then

		teacherData =
			runGeminiTeacher(
				text,
				internetResult
			)
			or teacherData

	else

		if GEMINI_ENABLED
			and not getGeminiAPIKey()
		then
			print(
				"[GEMINI] Teacher disabled - ServerStorage.GeminiAPIKey missing."
			)
		end
	end

	-----------------------------------------------------------------
	-- BUILD THE LOCAL BRAIN INPUT
	-----------------------------------------------------------------

	local brainInput = text

	-------------------------------------------------------------
	-- LOCAL LEARNED KNOWLEDGE
	-------------------------------------------------------------

	local localKnowledge =
		localKnowledgePreview

	if localKnowledge ~= "" then
		brainInput =
			brainInput
			..
			" "
			..
			localKnowledge
	end

	-------------------------------------------------------------
	-- LANGUAGE / THINKING STATE
	--
	-- IMPORTANT:
	-- parsed/thoughtPlan stay as Lua state only.
	-- Do NOT convert intent_, thought_, topic_, relation_, etc.
	-- into dictionary words, otherwise the neural decoder can
	-- learn them and literally say them.
	-------------------------------------------------------------

	-------------------------------------------------------------
	-- JUST-LEARNED STRUCTURED FACT
	-------------------------------------------------------------

	if learnedFact then

		brainInput =
			brainInput
			..
			" "
			..
			tostring(learnedFact.subject)
			..
			" "
			..
			tostring(learnedFact.relation)
			..
			" "
			..
			table.concat(
				learnedFact.targets,
				" "
			)
	end

	-------------------------------------------------------------
	-- GEMINI'S INTERPRETATION IS TRAINING/SEMANTIC CONTEXT ONLY
	-------------------------------------------------------------

	if teacherData.interpretation ~= "" then
		brainInput =
			brainInput
			..
			" "
			..
			teacherData.interpretation
	end

	-------------------------------------------------------------
	-- EXTRACTED FACTS CAN ALSO HELP THE INPUT VECTOR
	-------------------------------------------------------------

	if teacherData.facts ~= ""
		and string.upper(cleanText(teacherData.facts)) ~= "NONE"
	then
		brainInput =
			brainInput
			..
			" "
			..
			string.gsub(
				teacherData.facts,
				"|",
				" "
			)
	end

	-------------------------------------------------------------
	-- INTERNET INFORMATION IS INPUT CONTEXT, NOT THE FINAL ANSWER
	-------------------------------------------------------------

	if internetResult
		and internetResult.extract
	then

		local internetContext =
			cleanText(
				internetResult.extract
			)

		if #internetContext > 500 then
			internetContext =
				string.sub(
					internetContext,
					1,
					500
				)
		end

		brainInput =
			brainInput
			..
			" "
			..
			internetContext
	end

	-------------------------------------------------------------
	-- WORKING MEMORY CONTEXT
	--
	-- WorkingMemory still tracks the conversation through
	-- UpdateUser/UpdateAI, but we intentionally DO NOT call
	-- BuildBrainInput here. The old version re-added the current
	-- prompt plus older token history and drowned out the actual
	-- message for this small neural network.
	-------------------------------------------------------------

	print(
		"[BRAIN INPUT]",
		brainInput
	)

	-----------------------------------------------------------------
	-- NEXT-WORD GENERATION
	--
	-- Input vectors are now created inside generateNeuralResponse()
	-- for every generated word.
	-----------------------------------------------------------------

	-----------------------------------------------------------------
	-- NORMAL MEMORY LEARNING
	-----------------------------------------------------------------

	learnNormalMessage()

	-----------------------------------------------------------------
	-- STATE
	-----------------------------------------------------------------

	local wmState =
		safeCall(
			"WorkingMemory.GetState",
			WorkingMemory.GetState
		)
		or {}

	-----------------------------------------------------------------
	-- THE RESPONSE COMES FROM THE LOCAL NEURAL OUTPUT
	-----------------------------------------------------------------

	local response =
		generateNeuralResponse(
			brainInput,
			wmState
		)

	-----------------------------------------------------------------
	-- NO CANNED RESPONSE FALLBACK.
	--
	-- If the network genuinely has no decoded prediction yet, return
	-- an empty string. This makes it obvious that it still needs
	-- training instead of pretending it understood with canned text.
	-----------------------------------------------------------------

	if not response
		or response == ""
	then
		response = ""
	end

	-----------------------------------------------------------------
	-- WORKING MEMORY
	-----------------------------------------------------------------

	if response ~= "" then
		safeCall(
			"WorkingMemory.UpdateAI",
			WorkingMemory.UpdateAI,
			response
		)
	end

	-----------------------------------------------------------------
	-- SAVE
	-----------------------------------------------------------------

	saveBrain(false)

	-----------------------------------------------------------------
	-- LOG
	-----------------------------------------------------------------

	if response ~= "" then
		print(
			"[BRAIN RESPONSE]",
			response
		)
	else
		print(
			"[BRAIN RESPONSE] <no learned neural response yet>"
		)
	end

	return response
end

