		normalizeWord(word)
	)
end

---------------------------------------------------------------------
-- DEBUG WORD
---------------------------------------------------------------------

function Dictionary.DebugWord(word)

	word =
		normalizeWord(word)

	print(
		"========== CORE MEMORY =========="
	)

	print(
		"WORD:",
		word
	)

	local id =
		Dictionary.FindID(word)

	print(
		"ID:",
		id
	)

	if not id then

		print(
			"Unknown word."
		)

		return
	end

	local associated =
		Dictionary.GetAssociations(
			word,
			10
		)

	print(
		"ASSOCIATIONS:"
	)

	for _, result
		in ipairs(associated) do

		print(
			"  ->",
			result.word,
			result.strength
		)

	end

	local similar =
		Dictionary.VectorToScoredWords(
			Dictionary.vectors[id],
			10
		)

	print(
		"VECTOR SIMILARITY:"
	)

	for _, result
		in ipairs(similar) do

		print(
			"  ->",
			result.word,
			result.score
		)

	end

	print(
		"================================="
	)
end

