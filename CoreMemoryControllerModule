---------------------------------------------------------------------

function Dictionary.DebugText(text)

	local vector =
		Dictionary.TextToVector(
			text
		)

	local closest =
		Dictionary.VectorToScoredWords(
			vector,
			10
		)

	print(
		"========== TEXT VECTOR =========="
	)

	print(
		"INPUT:",
		text
	)

	for _, result
		in ipairs(closest) do

		print(
			result.word,
			result.score
		)

	end

	print(
		"================================="
	)

	return closest
end

