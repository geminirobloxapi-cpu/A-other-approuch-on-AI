---------------------------------------------------------------------
-- ASSOCIATION
---------------------------------------------------------------------

function Dictionary.GetAssociation(
	wordA,
	wordB
)

	wordA =
		normalizeWord(wordA)

	wordB =
		normalizeWord(wordB)

	local connections =
		Dictionary.associations[wordA]

	if not connections then
		return 0
	end

	return
		connections[wordB]
		or 0
end

---------------------------------------------------------------------
-- MOVE VECTOR TOWARD ANOTHER VECTOR
---------------------------------------------------------------------

local function moveVectorToward(
	source,
	target,
	amount
)

	for i = 1, VECTOR_SIZE do

		local a =
			source[i]
			or 0

		local b =
			target[i]
			or 0

		source[i] =
			a + ((b - a) * amount)

	end

	normalizeVector(source)
end

---------------------------------------------------------------------
-- LEARN ASSOCIATION
---------------------------------------------------------------------

function Dictionary.AssociateWords(
	wordA,
	wordB,
	amount
)

	wordA =
		normalizeWord(wordA)

	wordB =
		normalizeWord(wordB)

	if wordA == ""
		or wordB == ""
		or wordA == wordB
		or isInternalToken(wordA)
		or isInternalToken(wordB)
	then

		return
	end

	local idA =
		Dictionary.GetID(wordA)

	local idB =
		Dictionary.GetID(wordB)

	if not idA
		or not idB then
		return
	end

	Dictionary.associations[wordA] =
		Dictionary.associations[wordA]
		or {}

	Dictionary.associations[wordB] =
		Dictionary.associations[wordB]
		or {}

	amount =
		tonumber(amount)
		or 1

	-------------------------------------------------------------
	-- Association strength
	-------------------------------------------------------------

	Dictionary.associations[wordA][wordB] =
		math.clamp(
			(
				Dictionary.associations[wordA][wordB]
				or 0
			)
			+ amount,

			0,
			MAX_ASSOCIATION_STRENGTH
		)

	Dictionary.associations[wordB][wordA] =
		math.clamp(
			(
				Dictionary.associations[wordB][wordA]
				or 0
			)
			+ amount,

			0,
			MAX_ASSOCIATION_STRENGTH
		)

	-------------------------------------------------------------
	-- Semantic learning
	-------------------------------------------------------------

	local vectorA =
		Dictionary.vectors[idA]

	local vectorB =
		Dictionary.vectors[idB]

	if vectorA and vectorB then

		-- Copy first so modifying A doesn't affect the update to B.
		local originalA =
			table.clone(vectorA)

		local originalB =
			table.clone(vectorB)

		local learning =
			math.clamp(
				ASSOCIATION_LEARNING_RATE
				* amount,

				0,
				0.20
			)

		moveVectorToward(
			vectorA,
			originalB,
			learning
		)

		moveVectorToward(
			vectorB,
			originalA,
			learning
		)

	end

	Dictionary.dirty = true

	table.clear(
		Dictionary.cache
	)
end

---------------------------------------------------------------------
-- GET ASSOCIATED WORDS
---------------------------------------------------------------------

function Dictionary.GetAssociations(
	word,
	amount
)

	word =
		normalizeWord(word)

	amount =
		math.clamp(
			tonumber(amount)
			or 10,

			1,
			50
		)

	local connections =
		Dictionary.associations[word]

	if not connections then
		return {}
	end

	local results = {}

	for target, strength
		in pairs(connections) do

		table.insert(
			results,
			{
				word = target,
				strength = strength
			}
		)

	end

	table.sort(
		results,

		function(a, b)

			return
				a.strength
				>
			b.strength

		end
	)

	while #results > amount do
		table.remove(results)
	end

	return results
end

---------------------------------------------------------------------
-- TOKENIZE
---------------------------------------------------------------------

function Dictionary.Tokenize(text)

	local words = {}

	text =
		string.lower(
			tostring(text or "")
		)

	for word in string.gmatch(
		text,
		"[%w_']+"
		) do

		word =
			normalizeWord(word)

		if word ~= ""
			and not isInternalToken(word)
		then
			table.insert(
				words,
				word
			)
		end
	end

	return words
end

---------------------------------------------------------------------
-- CONTENT WORDS
---------------------------------------------------------------------

function Dictionary.GetContentWords(text)

	local words =
		Dictionary.Tokenize(text)

	local content = {}

	for _, word in ipairs(words) do

		if not STOP_WORDS[word]
			and not isInternalToken(word)
		then

			table.insert(
				content,
				word
			)

		end
	end

	return content
end

---------------------------------------------------------------------
-- LEARN SENTENCE RELATIONSHIPS
---------------------------------------------------------------------

function Dictionary.LearnFromText(text)

	if not AUTO_LEARN_ASSOCIATIONS then
		return
	end

	local words =
		Dictionary.GetContentWords(text)

	-------------------------------------------------------------
	-- Make sure words exist
	-------------------------------------------------------------

	for _, word in ipairs(words) do
		Dictionary.GetID(word)
	end

	-------------------------------------------------------------
	-- Co-occurrence learning
	-------------------------------------------------------------

	for i = 1, #words do

		local last =
			math.min(
				#words,
				i + ASSOCIATION_WINDOW
			)

		for j = i + 1, last do

			local distance =
				j - i

			-- Nearby words have stronger association.
			local strength =
				1 / distance

			Dictionary.AssociateWords(
				words[i],
				words[j],
				strength
			)

		end
	end
end

---------------------------------------------------------------------
-- MATH EXPRESSION CHECK
---------------------------------------------------------------------

local function isMathExpression(text)

	return
		string.match(
			tostring(text or ""),
			"^%s*[%d%+%-%*/%%%^%(%)%.]+%s*$"
		)
		~= nil
end

---------------------------------------------------------------------
-- TEXT -> VECTOR
---------------------------------------------------------------------

function Dictionary.TextToVector(text)

	text =
		tostring(text or "")

	local output =
		newZeroVector()

	if text == "" then
		return output
	end

	-------------------------------------------------------------
	-- Learn language relationships
	-------------------------------------------------------------

	Dictionary.LearnFromText(text)

	-------------------------------------------------------------
	-- Math is treated as one concept
	-------------------------------------------------------------

	if isMathExpression(text) then

		local id =
			Dictionary.GetID(text)

		local vector =
			id
			and Dictionary.vectors[id]

		if vector then

			for i = 1, VECTOR_SIZE do
				output[i] =
					vector[i]
					or 0
			end

		end

		return output
	end

	-------------------------------------------------------------
	-- Sentence embedding
	-------------------------------------------------------------

	local contentWords =
		Dictionary.GetContentWords(text)

	-------------------------------------------------------------
	-- Fallback:
	-- sentence may contain only stop words
	-------------------------------------------------------------

	if #contentWords == 0 then

		contentWords =
			Dictionary.Tokenize(text)

	end

	local count = 0

	for _, word in ipairs(contentWords) do

		local id =
			Dictionary.GetID(word)

		if id then

			local wordVector =
				Dictionary.vectors[id]

			if wordVector then

				for i = 1, VECTOR_SIZE do

					output[i] +=
						wordVector[i]
						or 0

				end

				count += 1
			end
		end
	end

	-------------------------------------------------------------
	-- Average
	-------------------------------------------------------------

	if count > 0 then

		for i = 1, VECTOR_SIZE do

			output[i] /=
				count

		end

	end

	normalizeVector(output)

	return output
end

---------------------------------------------------------------------
-- CONVERT NEURON PATTERN
---------------------------------------------------------------------

local function prepareInputVector(vector)

	local output =
		newZeroVector()

	local appearsBinary =
		true

	for i = 1, VECTOR_SIZE do

		local value =
			vector[i]
			or 0

		if value ~= 0
			and value ~= 1 then

			appearsBinary =
				false

			break
		end
	end

	-------------------------------------------------------------
	-- Neural output:
	--
	-- 0 -> -1
	-- 1 -> +1
	--
	-- This is important because word vectors exist from -1 to +1.
	-------------------------------------------------------------

	if appearsBinary then

		for i = 1, VECTOR_SIZE do

			if vector[i] == 1 then
				output[i] = 1
			else
				output[i] = -1
			end

		end

	else

		for i = 1, VECTOR_SIZE do

			output[i] =
				vector[i]
				or 0

		end

	end

	normalizeVector(output)

	return output
end

---------------------------------------------------------------------
-- VECTOR -> SCORED WORDS
---------------------------------------------------------------------

function Dictionary.VectorToScoredWords(
	vector,
	amount
)

	if typeof(vector) ~= "table" then
		return {}
	end

	amount =
		math.clamp(
			tonumber(amount)
			or 5,

			1,
			50
		)

	local prepared =
		prepareInputVector(vector)

	if magnitude(prepared) <= 0 then
		return {}
	end

	local results = {}

	for id, wordVector
		in pairs(Dictionary.vectors) do

		local word =
			Dictionary.reverse[id]

		if word
			and wordVector
			and not STOP_WORDS[word]
			and not isInternalToken(word)
		then

			local score =
				cosineSimilarity(
					prepared,
					wordVector
				)

			table.insert(
				results,
				{
					id = id,
					word = word,
					score = score
				}
			)
		end
	end

	table.sort(
		results,

		function(a, b)

			return
				a.score
				>
			b.score

		end
	)

	while #results > amount do
		table.remove(results)
	end

	return results
end

---------------------------------------------------------------------
-- VECTOR -> TOP WORDS
---------------------------------------------------------------------

function Dictionary.VectorToTopWords(
	vector,
	amount
)

	local scored =
		Dictionary.VectorToScoredWords(
			vector,
			amount
		)

	local words = {}

	for _, result in ipairs(scored) do

		table.insert(
			words,
			result.word
		)

	end

	return words
end

---------------------------------------------------------------------
-- VECTOR -> BEST WORD
---------------------------------------------------------------------

function Dictionary.VectorToWords(vector)

	if typeof(vector) ~= "table" then
		return "thinking"
	end

	-------------------------------------------------------------
	-- Cache
	-------------------------------------------------------------

	local cacheParts = {}

	for i = 1, VECTOR_SIZE do

		cacheParts[i] =
			string.format(
				"%.3f",
				vector[i]
				or 0
			)

	end

	local key =
		table.concat(
			cacheParts,
			","
		)

	local cached =
		Dictionary.cache[key]

	if cached then
		return cached
	end

	-------------------------------------------------------------
	-- Find closest
	-------------------------------------------------------------

	local results =
		Dictionary.VectorToScoredWords(
			vector,
			1
		)

	local word =
		"thinking"

	if results[1] then

		word =
			results[1].word

	end

	Dictionary.cache[key] =
		word

	return word
end

---------------------------------------------------------------------
-- REMOVE CONTAMINATED INTERNAL TOKENS
--
-- This cleans older saved dictionaries without deleting useful words.
---------------------------------------------------------------------

local function removeInternalTokens()

	local removed = 0
	local badWords = {}

	for word, id
		in pairs(Dictionary.words)
	do

		if isInternalToken(word) then

			badWords[word] = true

			Dictionary.words[word] = nil
			Dictionary.reverse[id] = nil
			Dictionary.vectors[id] = nil

			removed += 1
		end
	end

	-------------------------------------------------------------
	-- Remove their own association tables.
	-------------------------------------------------------------

	for word in pairs(badWords) do
		Dictionary.associations[word] = nil
	end

	-------------------------------------------------------------
	-- Remove links TO contaminated words.
	-------------------------------------------------------------

	for word, connections
		in pairs(Dictionary.associations)
	do

		if isInternalToken(word) then

			Dictionary.associations[word] = nil

		elseif typeof(connections) == "table" then

			for target in pairs(connections) do

				if badWords[target]
					or isInternalToken(target)
				then

					connections[target] = nil
				end
			end
		end
	end

	if removed > 0 then

		Dictionary.dirty = true

		table.clear(
			Dictionary.cache
		)

		print(
			"[CORE MEMORY] Removed",
			removed,
			"internal control tokens"
		)
	end

	return removed
end

---------------------------------------------------------------------
-- SAVE
---------------------------------------------------------------------

function Dictionary.Save()

	if not Dictionary.dirty then
		return true
	end

	local success =
		safeUpdate(
			"dictionary",

			function(old)

				-- We save the server's current brain state.
				--
				-- UpdateAsync is used instead of SetAsync so this
				-- operation is safer if servers overlap.

				return {

					version = 2,

					vectorSize =
					VECTOR_SIZE,

					words =
					Dictionary.words,

					reverse =
					Dictionary.reverse,

					vectors =
					Dictionary.vectors,

					associations =
					Dictionary.associations,

					nextID =
					Dictionary.nextID,

					savedAt =
					os.time()
				}
			end
		)

	if success then

		Dictionary.dirty =
			false

		print(
			"[CORE MEMORY] Saved",
			Dictionary.nextID - 1,
			"words"
		)

	end

	return success
end

---------------------------------------------------------------------
-- LOAD
---------------------------------------------------------------------

function Dictionary.Load()

	print(
		"[CORE MEMORY] Loading dictionary..."
	)

	local data =
		safeGet(
			"dictionary"
		)

	if typeof(data) == "table" then

		Dictionary.words =
			data.words
			or {}

		Dictionary.reverse =
			data.reverse
			or {}

		Dictionary.vectors =
			data.vectors
			or {}

		Dictionary.associations =
			data.associations
			or {}

		Dictionary.nextID =
			data.nextID
			or 1

		print(
			"[CORE MEMORY] Loaded",
			Dictionary.nextID - 1,
			"stored words"
		)

	else

		print(
			"[CORE MEMORY] No stored dictionary."
		)

	end

	-------------------------------------------------------------
	-- Remove old intent_/thought_/topic_ contamination
	-------------------------------------------------------------

	removeInternalTokens()

	-------------------------------------------------------------
	-- Repair loaded vectors
	-------------------------------------------------------------

	for id, word in pairs(
		Dictionary.reverse
		) do

		local vector =
			Dictionary.vectors[id]

		if typeof(vector) ~= "table" then

			Dictionary.vectors[id] =
				generateVector(
					word
				)

			Dictionary.dirty =
				true

		else

			---------------------------------------------------------
			-- Force exact vector length
			---------------------------------------------------------

			for i = 1, VECTOR_SIZE do

				if typeof(vector[i]) ~= "number" then

					vector[i] = 0

				end
			end

			normalizeVector(
				vector
			)

		end
	end

	-------------------------------------------------------------
	-- Add preprogrammed vocabulary
	-------------------------------------------------------------

	local added = 0

	for _, word
		in ipairs(PREPROGRAMMED_WORDS) do

		word =
			normalizeWord(word)

		if word ~= ""
			and not isInternalToken(word)
			and not Dictionary.words[word] then

			addWordNoSave(
				word
			)

			added += 1
		end
	end

	-------------------------------------------------------------
	-- PREPROGRAM BASIC SEMANTIC RELATIONSHIPS
	-------------------------------------------------------------

	local basicRelations = {

		{"dog", "animal"},
		{"dog", "pet"},

		{"cat", "animal"},
		{"cat", "pet"},

		{"bird", "animal"},
		{"fish", "animal"},

		{"human", "person"},
		{"people", "person"},

		{"happy", "good"},
		{"happy", "excited"},

		{"sad", "bad"},

		{"angry", "mad"},

		{"run", "move"},
		{"walk", "move"},
		{"go", "move"},

		{"talk", "speak"},
		{"talk", "say"},

		{"think", "thought"},
		{"think", "brain"},

		{"remember", "memory"},

		{"learn", "knowledge"},
		{"learning", "knowledge"},

		{"ai", "artificial"},
		{"ai", "intelligence"},
		{"ai", "brain"},

		{"neuron", "brain"},
		{"neurons", "brain"},

		{"vector", "embedding"},
		{"vectors", "embeddings"},

		{"roblox", "game"},
		{"studio", "roblox"},

		{"script", "code"},
		{"coding", "code"},

		{"computer", "machine"},

		{"big", "large"},
		{"small", "tiny"},

		{"fast", "speed"},

		{"good", "better"},
		{"bad", "worse"}
	}

	for _, relation
		in ipairs(basicRelations) do

		local a =
			relation[1]

		local b =
			relation[2]

		if Dictionary.GetAssociation(a, b) <= 0 then

			Dictionary.AssociateWords(
				a,
				b,
				2
			)

		end
	end

	if added > 0 then

		print(
			"[CORE MEMORY] Added",
			added,
			"preprogrammed words"
		)

	end

	print(
		"[CORE MEMORY] Ready:",
		Dictionary.nextID - 1,
		"words"
	)

	-- BrainController will handle saving.
end

