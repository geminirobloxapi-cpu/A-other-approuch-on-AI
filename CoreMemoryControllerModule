---------------------------------------------------------------------
-- INTERNAL CONTROL TOKEN FILTER
--
-- These are metadata used by LanguageController / ThinkingController.
-- They are NOT vocabulary and must never enter CoreMemory.
---------------------------------------------------------------------

local INTERNAL_PREFIXES = {
	"intent_",
	"topic_",
	"subject_",
	"relation_",
	"target_",
	"question_",
	"thought_",
	"brainstate_",
	"memorytag_",
	"systemtag_",
}

local function isInternalToken(word)

	word =
		string.lower(
			tostring(word or "")
		)

	for _, prefix
		in ipairs(INTERNAL_PREFIXES)
	do

		if string.sub(
			word,
			1,
			#prefix
			) == prefix
		then

			return true
		end
	end

	return false
end

