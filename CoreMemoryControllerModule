---------------------------------------------------------------------
-- NORMALIZE WORD
---------------------------------------------------------------------

local function normalizeWord(word)

	word =
		string.lower(
			tostring(word or "")
		)

	word =
		string.gsub(
			word,
			"^%p+",
			""
		)

	word =
		string.gsub(
			word,
			"%p+$",
			""
		)

	return word
end

---------------------------------------------------------------------
-- SAFE DATASTORE GET
---------------------------------------------------------------------

local function safeGet(key)

	local ok, result =
		pcall(function()

			return DictStore:GetAsync(key)

		end)

	if not ok then

		warn(
			"[CORE MEMORY] Load failed:",
			result
		)

		return nil
	end

	return result
end

---------------------------------------------------------------------
-- SAFE DATASTORE UPDATE
---------------------------------------------------------------------

local function safeUpdate(key, callback)

	local ok, result =
		pcall(function()

			return DictStore:UpdateAsync(
				key,
				callback
			)

		end)

	if not ok then

		warn(
			"[CORE MEMORY] Save failed:",
			result
		)

		return false
	end

	return true
end

---------------------------------------------------------------------
-- DETERMINISTIC RANDOM GENERATOR
---------------------------------------------------------------------

-- We don't want a word to receive a completely different vector
-- every time a datastore is reset.
--
-- This converts the word itself into a repeatable seed.

local function hashWord(word)

	local hash = 2166136261

	for i = 1, #word do

		hash =
			bit32.bxor(
				hash,
				string.byte(word, i)
			)

		hash =
			(hash * 16777619)
			% 2147483647
	end

	if hash <= 0 then
		hash = 1
	end

	return hash
end

---------------------------------------------------------------------
-- VECTOR HELPERS
---------------------------------------------------------------------

local function newZeroVector()

	local vector = {}

	for i = 1, VECTOR_SIZE do
		vector[i] = 0
	end

	return vector
end

---------------------------------------------------------------------

local function magnitude(vector)

	local total = 0

	for i = 1, VECTOR_SIZE do

		local value =
			vector[i]
			or 0

		total +=
			value * value
	end

	return math.sqrt(total)
end

---------------------------------------------------------------------

local function normalizeVector(vector)

	local mag =
		magnitude(vector)

	if mag <= 0 then
		return vector
	end

	for i = 1, VECTOR_SIZE do

		vector[i] =
			(vector[i] or 0)
			/ mag

	end

	return vector
end

---------------------------------------------------------------------
-- GENERATE STABLE VECTOR
---------------------------------------------------------------------

local function generateVector(word)

	local rng =
		Random.new(
			hashWord(word)
		)

	local vector = {}

	for i = 1, VECTOR_SIZE do

		vector[i] =
			rng:NextNumber(
				-1,
				1
			)

	end

	return normalizeVector(vector)
end

---------------------------------------------------------------------
-- COSINE SIMILARITY
---------------------------------------------------------------------

local function cosineSimilarity(a, b)

	local dot = 0
	local magA = 0
	local magB = 0

	for i = 1, VECTOR_SIZE do

		local av =
			a[i]
			or 0

		local bv =
			b[i]
			or 0

		dot +=
			av * bv

		magA +=
			av * av

		magB +=
			bv * bv
	end

	if magA <= 0
		or magB <= 0 then

		return -math.huge
	end

	return
		dot
		/
		math.sqrt(
			magA * magB
		)
end

---------------------------------------------------------------------
-- ADD WORD WITHOUT SAVING
---------------------------------------------------------------------

local function addWordNoSave(word)

	word =
		normalizeWord(word)

	if word == ""
		or isInternalToken(word)
	then
		return nil
	end

	local existing =
		Dictionary.words[word]

	if existing then
		return existing
	end

	local id =
		Dictionary.nextID

	Dictionary.nextID += 1

	Dictionary.words[word] =
		id

	Dictionary.reverse[id] =
		word

	Dictionary.vectors[id] =
		generateVector(word)

	Dictionary.associations[word] =
		Dictionary.associations[word]
		or {}

	Dictionary.dirty = true

	table.clear(
		Dictionary.cache
	)

	return id
end

---------------------------------------------------------------------
-- GET ID
---------------------------------------------------------------------

function Dictionary.GetID(word)

	word =
		normalizeWord(word)

	if word == ""
		or isInternalToken(word)
	then
		return nil
	end

	local existing =
		Dictionary.words[word]

	if existing then
		return existing
	end

	local id =
		addWordNoSave(word)

	print(
		"[CORE MEMORY] Learned word:",
		word,
		"ID:",
		id
	)

	-- IMPORTANT:
	--
	-- Do NOT save immediately.
	--
	-- BrainController already periodically calls Dictionary.Save().

	return id
end

