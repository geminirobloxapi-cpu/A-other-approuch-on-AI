				category.path
			)

		end
	end

	for word, relations
		in pairs(analysis.relations) do

		for _, relation
			in ipairs(relations) do

			print(
				"[RELATION]",
				word,
				relation.relation,
				relation.target
			)

		end
	end

	for _, hint
		in ipairs(analysis.hints) do

		print(
			"[HINT]",
			hint
		)

	end

	print("-------------------------------")

	return analysis
end

