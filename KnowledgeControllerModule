---------------------------------------------------------------------
-- WORD NORMALIZATION
---------------------------------------------------------------------

local function normalizeWord(word)

	if typeof(word) ~= "string" then
		return ""
	end

	word = string.lower(word)

	-- Remove punctuation around words.
	word = string.gsub(word, "^%p+", "")
	word = string.gsub(word, "%p+$", "")

	return word
end

---------------------------------------------------------------------
-- TOKENIZE
---------------------------------------------------------------------

function Knowledge.Tokenize(text)

	local words = {}

	if typeof(text) ~= "string" then
		return words
	end

	for word in string.gmatch(string.lower(text), "[%w']+") do

		word = normalizeWord(word)

		if word ~= "" then
			table.insert(words, word)
		end

		if #words >= MAX_WORDS then
			break
		end
	end

	return words
end

---------------------------------------------------------------------
-- SEARCH NESTED CATEGORY
---------------------------------------------------------------------

local function searchCategoryTable(data, word, path)

	for name, value in pairs(data) do

		if typeof(value) == "table" then

			---------------------------------------------------------
			-- Check whether this is a word list
			---------------------------------------------------------

			local appearsToBeList = (#value > 0)

			if appearsToBeList then

				for _, item in ipairs(value) do

					if normalizeWord(item) == word then

						return {
							category = path[1],
							subcategory = name,
							path = table.concat(path, ".") .. "." .. name
						}

					end
				end

			else

				-----------------------------------------------------
				-- Nested category
				-----------------------------------------------------

				local newPath = table.clone(path)
				table.insert(newPath, name)

				local found =
					searchCategoryTable(
						value,
						word,
						newPath
					)

				if found then
					return found
				end
			end
		end
	end

	return nil
end

---------------------------------------------------------------------
-- GET CATEGORY
---------------------------------------------------------------------

function Knowledge.GetCategory(word)

	word = normalizeWord(word)

	if word == "" then
		return nil
	end

	for categoryName, categoryData in pairs(Knowledge.Categories) do

		local found =
			searchCategoryTable(
				categoryData,
				word,
				{categoryName}
			)

		if found then

			return
				found.category,
				found.subcategory,
				found.path

		end
	end

	return nil
end

---------------------------------------------------------------------
-- GET ALL CATEGORIES
---------------------------------------------------------------------

function Knowledge.GetCategories(word)

	word = normalizeWord(word)

	local results = {}

	if word == "" then
		return results
	end

	local function search(data, rootCategory, path)

		for name, value in pairs(data) do

			if typeof(value) == "table" then

				if #value > 0 then

					for _, item in ipairs(value) do

						if normalizeWord(item) == word then

							table.insert(results, {

								category = rootCategory,
								subcategory = name,
								path =
									table.concat(
										path,
										"."
									)
									.. "."
									.. name
							})

						end
					end

				else

					local newPath =
						table.clone(path)

					table.insert(
						newPath,
						name
					)

					search(
						value,
						rootCategory,
						newPath
					)
				end
			end
		end
	end

	for categoryName, categoryData
		in pairs(Knowledge.Categories) do

		search(
			categoryData,
			categoryName,
			{categoryName}
		)

	end

	return results
end

---------------------------------------------------------------------
-- RELATION LOOKUP
---------------------------------------------------------------------

function Knowledge.GetRelation(word)

	word = normalizeWord(word)

	if word == "" then
		return nil
	end

	for relationName, relationData in pairs(Knowledge.Relations) do

		local target =
			relationData[word]

		if target ~= nil then

			return
				relationName,
				target

		end
	end

	return nil
end

---------------------------------------------------------------------
-- GET EVERY RELATION
---------------------------------------------------------------------

function Knowledge.GetRelations(word)

	word = normalizeWord(word)

	local found = {}

	for relationName, relationData
		in pairs(Knowledge.Relations) do

		local target =
			relationData[word]

		if target ~= nil then

			table.insert(found, {
				relation = relationName,
				target = target
			})

		end
	end

	return found
end

---------------------------------------------------------------------
-- MATH DETECTION
---------------------------------------------------------------------

function Knowledge.IsMathExpression(text)

	if typeof(text) ~= "string" then
		return false
	end

	-- Remove whitespace.
	local cleaned =
		string.gsub(
			text,
			"%s+",
			""
		)

	if cleaned == "" then
		return false
	end

	-- Must contain at least one digit.
	if not string.find(cleaned, "%d") then
		return false
	end

	-- Only mathematical characters allowed.
	return
		string.match(
			cleaned,
			"^[%d%+%-%*/%%%^%(%)%.]+$"
		)
		~= nil
end

---------------------------------------------------------------------
-- DETECT QUESTION
---------------------------------------------------------------------

function Knowledge.IsQuestion(text)

	if typeof(text) ~= "string" then
		return false
	end

	local lowered =
		string.lower(text)

	if string.find(text, "?", 1, true) then
		return true
	end

	local firstWord =
		string.match(
			lowered,
			"^%s*(%w+)"
		)

	if not firstWord then
		return false
	end

	local questionWords = {
		who = true,
		what = true,
		when = true,
		where = true,
		why = true,
		how = true,

		can = true,
		could = true,

		["do"] = true,
		does = true,
		did = true,

		is = true,
		are = true,
		was = true,
		were = true,

		will = true,
		would = true,

		should = true
	}

	return
		questionWords[firstWord]
		== true
end

---------------------------------------------------------------------
-- TEMPLATE LOOKUP
---------------------------------------------------------------------

local function getTemplate(category, subcategory)

	local categoryTemplates =
		Knowledge.Templates[category]

	if typeof(categoryTemplates) ~= "table" then
		return nil
	end

	return
		categoryTemplates[subcategory]
		or categoryTemplates.default
end

---------------------------------------------------------------------
-- UNIQUE RESULT HELPER
---------------------------------------------------------------------

local function addUnique(results, seen, value)

	if typeof(value) ~= "string" then
		return
	end

	if value == "" then
		return
	end

	if seen[value] then
		return
	end

	seen[value] = true

	table.insert(
		results,
		value
	)

end

---------------------------------------------------------------------
-- FORMAT RELATION
---------------------------------------------------------------------

local function describeRelation(word, relationName, target)

	if relationName == "opposite" then

		return
			'"'
			.. tostring(target)
			.. '" is an opposite of "'
			.. word
			.. '".'

	elseif relationName == "similar" then

		if typeof(target) == "table" then

			return
				'Words related to "'
				.. word
				.. '" include '
				.. table.concat(
					target,
					", "
				)
				.. "."

		end

	elseif relationName == "bigger" then

		return
			tostring(target)
			.. " is numerically larger than "
			.. word
			.. "."

	elseif relationName == "smaller" then

		return
			tostring(target)
			.. " is numerically smaller than "
			.. word
			.. "."

	end

	return
		'"'
		.. word
		.. '" has a '
		.. relationName
		.. " relation to "
		.. tostring(target)
		.. "."
end

---------------------------------------------------------------------
-- INFER MEANING
---------------------------------------------------------------------

function Knowledge.InferMeaning(text)

	local results = {}
	local seen = {}

	if typeof(text) ~= "string" then
		return results
	end

	if text == "" then
		return results
	end

	-----------------------------------------------------------------
	-- Math
	-----------------------------------------------------------------

	if Knowledge.IsMathExpression(text) then

		addUnique(
			results,
			seen,
			"This looks like a mathematical expression."
		)

	end

	-----------------------------------------------------------------
	-- Question
	-----------------------------------------------------------------

	if Knowledge.IsQuestion(text) then

		addUnique(
			results,
			seen,
			"The user appears to be asking a question."
		)

	end

	-----------------------------------------------------------------
	-- Words
	-----------------------------------------------------------------

	local words =
		Knowledge.Tokenize(text)

	for _, word in ipairs(words) do

		-------------------------------------------------------------
		-- Categories
		-------------------------------------------------------------

		local categories =
			Knowledge.GetCategories(word)

		for _, info in ipairs(categories) do

			local description =
				getTemplate(
					info.category,
					info.subcategory
				)

			if description then

				addUnique(
					results,
					seen,
					description
				)

			end
		end

		-------------------------------------------------------------
		-- Relations
		-------------------------------------------------------------

		local relations =
			Knowledge.GetRelations(word)

		for _, relationInfo in ipairs(relations) do

			local description =
				describeRelation(
					word,
					relationInfo.relation,
					relationInfo.target
				)

			addUnique(
				results,
				seen,
				description
			)

		end

		-------------------------------------------------------------
		-- Prevent gigantic result tables
		-------------------------------------------------------------

		if #results >= MAX_HINTS then
			break
		end

	end

	-----------------------------------------------------------------
	-- Limit output
	-----------------------------------------------------------------

	while #results > MAX_HINTS do
		table.remove(results)
	end

	return results
end

---------------------------------------------------------------------
-- ANALYZE TEXT
---------------------------------------------------------------------

function Knowledge.Analyze(text)

	local analysis = {

		words = {},
		categories = {},
		relations = {},
		isQuestion = false,
		isMath = false,
		hints = {}
	}

	if typeof(text) ~= "string" then
		return analysis
	end

	analysis.words =
		Knowledge.Tokenize(text)

	analysis.isQuestion =
		Knowledge.IsQuestion(text)

	analysis.isMath =
		Knowledge.IsMathExpression(text)

	-----------------------------------------------------------------
	-- Analyze each word
	-----------------------------------------------------------------

	for _, word in ipairs(analysis.words) do

		local categories =
			Knowledge.GetCategories(word)

		if #categories > 0 then

			analysis.categories[word] =
				categories

		end

		local relations =
			Knowledge.GetRelations(word)

		if #relations > 0 then

			analysis.relations[word] =
				relations

		end

	end

	analysis.hints =
		Knowledge.InferMeaning(text)

	return analysis
end

