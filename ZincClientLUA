local function NeuronFade(message, anger, happy, sad)

	--------------------------------------------------
	-- SETTINGS
	--------------------------------------------------

	local Categories = Settings.Pathways.Pathways or Settings.Pathways
	local CloseMeanings = Settings.CloseMeanings or {}
	local SafetyTopics = Settings.SafetyTopics or {}

	local MINIMUM_SCORE = 0.25
	local MIN_CONCEPT_MATCH = 0.15

	local CONCEPT_WEIGHT = 0.55
	local EMOTION_WEIGHT = 0.25
	local TOPIC_WEIGHT = 0.20

	local MAX_COMBINED_SENTENCES = 4

	local FORGET_RATE = tonumber(Settings.ForgetRate) or 0.08

	--------------------------------------------------
	-- EMOTIONS
	--------------------------------------------------

	anger = math.clamp(tonumber(anger) or Settings.Angry or 0, 0, 1)
	happy = math.clamp(tonumber(happy) or Settings.Happy or 0, 0, 1)
	sad = math.clamp(tonumber(sad) or Settings.Sad or 0, 0, 1)

	--------------------------------------------------
	-- TEXT NORMALIZATION
	--------------------------------------------------

	local function Normalize(text)

		text = string.lower(tostring(text or ""))

		text = text:gsub("[^%w%s']", " ")
		text = text:gsub("%s+", " ")
		text = text:gsub("^%s+", "")
		text = text:gsub("%s+$", "")

		return text
	end

	local NormalizedMessage = Normalize(message)

	local function Tokenize(text)

		local words = {}

		for word in Normalize(text):gmatch("[%w']+") do
			words[word] = true
		end

		return words
	end

	local function CountWords(words)

		local count = 0

		for _ in pairs(words) do
			count += 1
		end

		return count
	end

	local InputWords = Tokenize(message)
	local InputCount = CountWords(InputWords)

	--------------------------------------------------
	-- PHRASE MATCHING
	--------------------------------------------------

	local function ContainsPhrase(text, phrase)

		local normalized = Normalize(phrase)

		if normalized == "" then
			return false
		end

		local paddedText = " " .. Normalize(text) .. " "
		local paddedPhrase = " " .. normalized .. " "

		return string.find(
			paddedText,
			paddedPhrase,
			1,
			true
		) ~= nil
	end

	--------------------------------------------------
	-- CONTEXT REFLECTION
	--------------------------------------------------

	local Context = {

		Personal = false,
		Question = false,
		Educational = false,
		Fictional = false,
		Prevention = false,

		MatchedMarkers = {},

	}

	local ContextMarkers = {

		Personal = {
			"i feel",
			"i want",
			"i am",
			"im",
			"myself",
			"my life",
			"i have been",
			"i cannot",
			"i can't",
			"i dont want",
			"i don't want",
		},

		Question = {
			"what is",
			"what does",
			"how does",
			"how can",
			"why does",
			"can someone",
			"is it possible",
			"what happens",
		},

		Educational = {
			"for school",
			"research",
			"definition",
			"explaining",
			"learning about",
			"studying",
			"in psychology",
			"in science",
		},

		Fictional = {
			"in my game",
			"in my story",
			"fictional character",
			"my character",
			"in a movie",
			"in a book",
			"roleplay",
		},

		Prevention = {
			"suicide prevention",
			"help someone",
			"prevent suicide",
			"support someone",
			"helping a friend",
			"crisis support",
		},

	}

	for contextName, markers in pairs(ContextMarkers) do

		for _, marker in ipairs(markers) do

			if ContainsPhrase(NormalizedMessage, marker) then

				Context[contextName] = true

				table.insert(
					Context.MatchedMarkers,
					marker
				)

			end

		end

	end

	--------------------------------------------------
	-- TOPIC SCORING
	--------------------------------------------------

	local function GetTopicScore(topic)

		if type(topic) == "string" then
			topic = {topic}
		end

		if type(topic) ~= "table" then
			return 0, {}
		end

		local matched = {}
		local score = 0

		for _, phrase in ipairs(topic) do

			if type(phrase) == "string"
				and ContainsPhrase(NormalizedMessage, phrase) then

				score += 1

				table.insert(matched, phrase)

			end

		end

		-- Multiple matching topic phrases
		-- increase confidence, but cap the score.

		local normalizedScore = math.clamp(
			score / 2,
			0,
			1
		)

		return normalizedScore, matched
	end

	--------------------------------------------------
	-- REFLECT ALL SAFETY TOPICS
	--
	-- Detection only. No automatic responses.
	--------------------------------------------------

	local SafetyMatches = {}

	for topicName, topic in pairs(SafetyTopics) do

		if type(topic) == "table" then

			local score, matched = GetTopicScore(
				topic.Keywords
			)

			if score > 0 then

				table.insert(SafetyMatches, {

					Name = topicName,
					Score = score,
					Priority = topic.Priority or 0,
					Keywords = matched,

				})

			end

		end

	end

	table.sort(
		SafetyMatches,
		function(a, b)

			if a.Priority == b.Priority then
				return a.Score > b.Score
			end

			return a.Priority > b.Priority

		end
	)

	--------------------------------------------------
	-- PATHWAY TOPIC PREDICTION
	--------------------------------------------------

	local TopicPredictions = {}

	for categoryName, category in pairs(Categories) do

		if type(category) == "table" then

			local score, matched = GetTopicScore(
				category.topic
			)

			if score > 0 then

				table.insert(TopicPredictions, {

					Name = categoryName,
					Score = score,
					Keywords = matched,

				})

			end

		end

	end

	table.sort(
		TopicPredictions,
		function(a, b)
			return a.Score > b.Score
		end
	)

	local BestTopic = TopicPredictions[1]
	local BestSafetyTopic = SafetyMatches[1]

	--------------------------------------------------
	-- EMOTION SIMILARITY
	--------------------------------------------------

	local function EmotionSimilarity(emotion)

		if type(emotion) ~= "table" then
			return 0.5
		end

		local neutral = math.clamp(
			1 - math.max(anger, happy, sad),
			0,
			1
		)

		local differences = {}
		local dimensions = 0

		local function Compare(key, inputValue)

			local value = tonumber(emotion[key])

			if value ~= nil then

				table.insert(
					differences,
					math.abs(value - inputValue)
				)

				dimensions += 1

			end

		end

		Compare("Anger", anger)
		Compare("Happy", happy)
		Compare("Sad", sad)
		Compare("Neutral", neutral)

		if dimensions == 0 then
			return 0.5
		end

		local total = 0

		for _, difference in ipairs(differences) do
			total += difference
		end

		return math.clamp(
			1 - total / dimensions,
			0,
			1
		)
	end

	--------------------------------------------------
	-- SENTENCE SIMILARITY
	--------------------------------------------------

	local function SentenceSimilarity(sentence)

		local SentenceWords = Tokenize(sentence)
		local sentenceCount = CountWords(SentenceWords)

		if InputCount == 0 or sentenceCount == 0 then
			return 0
		end

		local matched = 0

		for word in pairs(InputWords) do

			if SentenceWords[word] then
				matched += 1
			end

		end

		local inputCoverage = matched / InputCount
		local sentenceCoverage = matched / sentenceCount

		return math.clamp(
			(inputCoverage * 0.75) +
				(sentenceCoverage * 0.25),
			0,
			1
		)
	end

	--------------------------------------------------
	-- COLLECT PATHWAY CANDIDATES
	--------------------------------------------------

	local Candidates = {}

	local function AddCandidate(
		sentence,
		emotion,
		owner,
		ownerKey,
		category,
		topicScore
	)

		if type(sentence) ~= "string"
			or sentence == "" then
			return
		end

		table.insert(Candidates, {

			Sentence = sentence,
			Emotion = emotion,

			Owner = owner,
			OwnerKey = ownerKey,

			Category = category,
			TopicScore = topicScore or 0,

		})

	end

	--------------------------------------------------
	-- SEARCH ALL KNOWLEDGE PATHWAYS
	--------------------------------------------------

	for CategoryName, Category in pairs(Categories) do

		if type(Category) == "table"
			and type(Category.concepts) == "table" then

			local CategoryTopicScore = GetTopicScore(
				Category.topic
			)

			for _, Concept in ipairs(Category.concepts) do

				if type(Concept) == "table" then

					local Emotion = {

						Anger = Concept.Anger,
						Happy = Concept.Happy,
						Sad = Concept.Sad,
						Neutral = Concept.Neutral,

					}

					for conceptName, definition in pairs(Concept) do

						if type(definition) == "string"
							and conceptName ~= "Anger"
							and conceptName ~= "Happy"
							and conceptName ~= "Sad"
							and conceptName ~= "Neutral" then

							AddCandidate(
								definition,
								Emotion,
								Concept,
								conceptName,
								CategoryName,
								CategoryTopicScore
							)

						end

					end

				end

			end

		end

	end

	--------------------------------------------------
	-- SCORE ALL CANDIDATES
	--------------------------------------------------

	local BestCandidate = nil
	local BestScore = -1

	local MatchedCandidates = {}

	for _, Candidate in ipairs(Candidates) do

		local ConceptScore = SentenceSimilarity(
			Candidate.Sentence
		)

		local EmotionScore = EmotionSimilarity(
			Candidate.Emotion
		)

		local FinalScore

		if Candidate.TopicScore > 0 then

			FinalScore =
				(ConceptScore * CONCEPT_WEIGHT) +
				(EmotionScore * EMOTION_WEIGHT) +
				(Candidate.TopicScore * TOPIC_WEIGHT)

		else

			-- Don't penalize pathways that have no topic field.

			FinalScore =
				(ConceptScore * 0.65) +
				(EmotionScore * 0.35)

		end

		Candidate.ConceptScore = ConceptScore
		Candidate.EmotionScore = EmotionScore
		Candidate.FinalScore = FinalScore

		--------------------------------------------------
		-- BEST CANDIDATE
		--------------------------------------------------

		if FinalScore >= MINIMUM_SCORE
			and FinalScore > BestScore then

			BestScore = FinalScore
			BestCandidate = Candidate

		end

		--------------------------------------------------
		-- RELATED CANDIDATES
		--------------------------------------------------

		if ConceptScore >= MIN_CONCEPT_MATCH
			and FinalScore >= MINIMUM_SCORE then

			table.insert(
				MatchedCandidates,
				Candidate
			)

		end

	end

	--------------------------------------------------
	-- SORT CANDIDATES
	--------------------------------------------------

	table.sort(
		MatchedCandidates,
		function(a, b)
			return a.FinalScore > b.FinalScore
		end
	)

	--------------------------------------------------
	-- REMOVE DUPLICATES
	--------------------------------------------------

	local UniqueCandidates = {}
	local SeenSentences = {}

	for _, Candidate in ipairs(MatchedCandidates) do

		local Normalized = Normalize(
			Candidate.Sentence:gsub("[%p]", "")
		)

		if not SeenSentences[Normalized] then

			SeenSentences[Normalized] = true

			table.insert(
				UniqueCandidates,
				Candidate
			)

		end

		if #UniqueCandidates >= MAX_COMBINED_SENTENCES then
			break
		end

	end

	--------------------------------------------------
	-- RECONSTRUCT RESPONSE
	--------------------------------------------------

	local function MakeReadable(text)

		text = text:gsub("^%s+", "")
		text = text:gsub("%s+$", "")

		if text == "" then
			return ""
		end

		text = string.upper(
			string.sub(text, 1, 1)
		) .. string.sub(text, 2)

		if not text:match("[%.%!%?]$") then
			text ..= "."
		end

		return text
	end

	local CombinedSentences = {}

	for _, Candidate in ipairs(UniqueCandidates) do

		local Sentence = MakeReadable(
			Candidate.Sentence
		)

		if Sentence ~= "" then

			table.insert(
				CombinedSentences,
				Sentence
			)

		end

	end

	local ReconstructedResponse = table.concat(
		CombinedSentences,
		" "
	)

	--------------------------------------------------
	-- NEURON FADING / FORGETTING
	--------------------------------------------------

	if BestCandidate
		and BestCandidate.Owner
		and BestCandidate.OwnerKey then

		local Owner = BestCandidate.Owner
		local OwnerKey = BestCandidate.OwnerKey

		local OriginalDefinition = Owner[OwnerKey]

		if type(OriginalDefinition) == "string"
			and math.random() <= FORGET_RATE then

			local EligibleWords = {}

			for word in OriginalDefinition:gmatch("[%w']+") do

				local alternatives = CloseMeanings[
				string.lower(word)
				]

				if type(alternatives) == "table" then

					local ValidAlternatives = {}

					for _, alternative in ipairs(alternatives) do

						if type(alternative) == "string"
							and alternative ~= ""
							and string.lower(alternative) ~= string.lower(word) then

							table.insert(
								ValidAlternatives,
								alternative
							)

						end

					end

					if #ValidAlternatives > 0 then

						table.insert(EligibleWords, {

							Original = word,
							Alternatives = ValidAlternatives,

						})

					end

				end

			end

			if #EligibleWords > 0 then

				local Selected = EligibleWords[
				math.random(1, #EligibleWords)
				]

				local Replacement = Selected.Alternatives[
				math.random(1, #Selected.Alternatives)
				]

				local Replaced = false

				local NewDefinition = OriginalDefinition:gsub(
					"[%w']+",
					function(word)

						if not Replaced
							and string.lower(word)
							== string.lower(Selected.Original) then

							Replaced = true

							return Replacement
						end

						return word

					end
				)

				if Replaced then

					Owner[OwnerKey] = NewDefinition

					print(
						"[ZINC NEURON FADE]",
						OriginalDefinition,
						"->",
						NewDefinition
					)

				end

			end

		end

	end

	--------------------------------------------------
	-- PREDICTION METADATA
	--------------------------------------------------

	local Metadata = {

		Confidence = math.max(BestScore, 0),

		Context = Context,

		Topic = BestTopic and BestTopic.Name or nil,

		TopicScore = BestTopic and BestTopic.Score or 0,

		SafetyDetected = BestSafetyTopic ~= nil,

		SafetyTopic = BestSafetyTopic
			and BestSafetyTopic.Name or nil,

		SafetyPriority = BestSafetyTopic
			and BestSafetyTopic.Priority or 0,

		SafetyKeywords = BestSafetyTopic
			and BestSafetyTopic.Keywords or {},

		PersonalContext = Context.Personal,

		QuestionContext = Context.Question,

		EducationalContext = Context.Educational,

		FictionalContext = Context.Fictional,

		PreventionContext = Context.Prevention,

		SafetyResponseEnabled = false,

	}

	--------------------------------------------------
	-- NO MATCH
	--------------------------------------------------

	if not BestCandidate then

		Metadata.Confidence = 0
		Metadata.Reconstructed = false
		Metadata.CombinedSentences = 0

		return "I don't know that.", 0, Metadata

	end

	--------------------------------------------------
	-- FINAL RESPONSE
	--------------------------------------------------

	local OutputSentence = ReconstructedResponse

	if OutputSentence == "" then
		OutputSentence = BestCandidate.Sentence
	end

	--------------------------------------------------
	-- DEBUG OUTPUT
	--------------------------------------------------

	print("========== ZINC NEURON ==========")

	print("Input:", message)

	print("Response:", OutputSentence)

	print("Best Pathway:", BestCandidate.Category)

	print("Best Concept:", BestCandidate.OwnerKey)

	print("Concept Score:", BestCandidate.ConceptScore)

	print("Emotion Score:", BestCandidate.EmotionScore)

	print("Final Score:", BestCandidate.FinalScore)

	print("Predicted Topic:", Metadata.Topic)

	print("Topic Score:", Metadata.TopicScore)

	print("Safety Detected:", Metadata.SafetyDetected)

	print("Safety Topic:", Metadata.SafetyTopic)

	print("Personal Context:", Context.Personal)

	print("Question Context:", Context.Question)

	print("Educational Context:", Context.Educational)

	print("Fictional Context:", Context.Fictional)

	print("Prevention Context:", Context.Prevention)

	print("Combined Sentences:", #UniqueCandidates)

	print("=================================")

	--------------------------------------------------
	-- RETURN
	--------------------------------------------------

	Metadata.Sentence = OutputSentence

	Metadata.Category = BestCandidate.Category
	Metadata.Concept = BestCandidate.OwnerKey

	Metadata.ConceptScore = BestCandidate.ConceptScore
	Metadata.EmotionScore = BestCandidate.EmotionScore

	Metadata.FinalScore = BestCandidate.FinalScore

	Metadata.CombinedSentences = #UniqueCandidates

	Metadata.Reconstructed = #UniqueCandidates > 1

	return OutputSentence, BestCandidate.FinalScore * 100, Metadata

end




local function EmotionHandling(message)

	local EmotionPathways = Settings.EmotionPathways

	if type(EmotionPathways) ~= "table" then
		warn("Settings.EmotionPathways is missing!")
		return 0, 0, 0
	end

	message = string.lower(tostring(message))

	local BestMatch = nil
	local BestScore = 0

	local Emotions = {
		Anger = 0,
		Happy = 0,
		Sad = 0
	}

	-- Scan each emotion category
	for EmotionName, Pathways in pairs(EmotionPathways) do

		for _, Data in ipairs(Pathways) do

			local Phrase = string.lower(Data[1])

			-- Search for matching phrase
			if string.find(message, Phrase, 1, true) then

				-- Longer matches receive higher priority
				local Score = #Phrase

				if Score > BestScore then

					BestScore = Score
					BestMatch = Phrase

					Emotions.Anger = Data.Anger or 0
					Emotions.Happy = Data.Happy or 0
					Emotions.Sad = Data.Sad or 0

				end
			end
		end
	end

	print("========== EMOTION PREDICTION ==========")

	print("Input:", message)
	print("Matched:", BestMatch or "No match")

	print("Anger:", Emotions.Anger)
	print("Happy:", Emotions.Happy)
	print("Sad:", Emotions.Sad)

	print("========================================")

	NeuronFade(message, Emotions.Anger, Emotions.Happy, Emotions.Sad)
end

local storedmessages = {}

game.Players.LocalPlayer.Chatted:Connect(function(msg)

	EmotionHandling(msg)

end)
