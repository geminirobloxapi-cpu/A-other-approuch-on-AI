local function NeuronFade(message, anger, happy, sad)

	--------------------------------------------------
	-- SETTINGS
	--------------------------------------------------

	local Categories = Settings.Pathways.Pathways or Settings.Pathways
	local CloseMeanings = Settings.CloseMeanings or {}
	local MatchedCombinations = Settings.MatchedCombinations or {}
	local EmotionPathways = Settings.EmotionPathways or {}

	local MINIMUM_SCORE = 0.2

	local CONCEPT_WEIGHT = 0.65
	local EMOTION_WEIGHT = 0.35

	local FORGET_RATE = tonumber(Settings.ForgetRate) or 0.08

	--------------------------------------------------
	-- EMOTIONS
	--------------------------------------------------

	anger = tonumber(anger) or Settings.Angry or 0
	happy = tonumber(happy) or Settings.Happy or 0
	sad = tonumber(sad) or Settings.Sad or 0

	anger = math.clamp(anger, 0, 1)
	happy = math.clamp(happy, 0, 1)
	sad = math.clamp(sad, 0, 1)

	--------------------------------------------------
	-- TOKENIZER
	--------------------------------------------------

	local function Tokenize(text)

		local words = {}

		for word in string.lower(tostring(text or "")):gmatch("[%w']+") do
			words[word] = true
		end

		return words
	end

	local function CountWords(words)

		local count = 0

		for _ in pairs(words) do
			count += 1
		end

		return count
	end

	local InputWords = Tokenize(message)

	--------------------------------------------------
	-- EMOTION SIMILARITY
	--------------------------------------------------

	local function EmotionSimilarity(emotion)

		if type(emotion) ~= "table" then
			return 0.5
		end

		local inputNeutral = math.clamp(
			1 - math.max(anger, happy, sad),
			0,
			1
		)

		local differences = {}
		local dimensions = 0

		local function Compare(key, inputValue)

			local value = tonumber(emotion[key])

			if value ~= nil then

				table.insert(
					differences,
					math.abs(value - inputValue)
				)

				dimensions += 1

			end
		end

		Compare("Anger", anger)
		Compare("Happy", happy)
		Compare("Sad", sad)
		Compare("Neutral", inputNeutral)

		if dimensions == 0 then
			return 0.5
		end

		local totalDifference = 0

		for _, difference in ipairs(differences) do
			totalDifference += difference
		end

		local averageDifference = totalDifference / dimensions

		return math.clamp(1 - averageDifference, 0, 1)
	end

	--------------------------------------------------
	-- SENTENCE SIMILARITY
	-- EXACT WORDS ONLY
	--------------------------------------------------

	local function SentenceSimilarity(sentence)

		local SentenceWords = Tokenize(sentence)

		local inputCount = CountWords(InputWords)
		local sentenceCount = CountWords(SentenceWords)

		if inputCount == 0 or sentenceCount == 0 then
			return 0
		end

		local matched = 0

		for word in pairs(InputWords) do

			if SentenceWords[word] then
				matched += 1
			end

		end

		local inputCoverage = matched / inputCount
		local sentenceCoverage = matched / sentenceCount

		return math.clamp(
			(inputCoverage * 0.75) +
				(sentenceCoverage * 0.25),
			0,
			1
		)
	end

	--------------------------------------------------
	-- CANDIDATES
	--------------------------------------------------

	local Candidates = {}

	local function AddCandidate(
		sentence,
		emotion,
		source,
		owner,
		ownerKey
	)

		if type(sentence) ~= "string" or sentence == "" then
			return
		end

		table.insert(Candidates, {

			Sentence = sentence,

			Emotion = emotion,

			Source = source,

			Owner = owner,

			OwnerKey = ownerKey

		})

	end

	--------------------------------------------------
	-- PATHWAY CONCEPTS
	--------------------------------------------------

	for CategoryName, Category in pairs(Categories) do

		if type(Category) == "table"
			and type(Category.concepts) == "table" then

			for _, Concept in ipairs(Category.concepts) do

				if type(Concept) == "table" then

					local Emotion = {

						Anger = Concept.Anger,
						Happy = Concept.Happy,
						Sad = Concept.Sad,
						Neutral = Concept.Neutral

					}

					for conceptName, definition in pairs(Concept) do

						if type(definition) == "string"
							and conceptName ~= "Anger"
							and conceptName ~= "Happy"
							and conceptName ~= "Sad"
							and conceptName ~= "Neutral" then

							AddCandidate(
								definition,
								Emotion,
								CategoryName,
								Concept,
								conceptName
							)

						end

					end
				end
			end
		end
	end

	--------------------------------------------------
	-- MATCHED COMBINATIONS
	-- THESE ARE COMPLETE PHRASES, NOT CLOSE MEANINGS
	--------------------------------------------------

	for word in pairs(InputWords) do

		local combinations = MatchedCombinations[word]

		if type(combinations) == "table" then

			for _, sentence in ipairs(combinations) do

				if type(sentence) == "string" then

					AddCandidate(
						sentence,
						nil,
						"MatchedCombination",
						nil,
						nil
					)

				end

			end
		end
	end

	--------------------------------------------------
	-- EMOTION PATHWAYS
	--------------------------------------------------

	for EmotionName, EmotionCategory in pairs(EmotionPathways) do

		if type(EmotionCategory) == "table" then

			for _, Entry in ipairs(EmotionCategory) do

				if type(Entry) == "table"
					and type(Entry[1]) == "string" then

					AddCandidate(
						Entry[1],
						{
							Anger = Entry.Anger,
							Happy = Entry.Happy,
							Sad = Entry.Sad,
							Neutral = Entry.Neutral
						},
						EmotionName,
						Entry,
						1
					)

				end

			end
		end
	end

	--------------------------------------------------
	-- FIND BEST PATHWAY
	--------------------------------------------------

	local BestCandidate = nil
	local BestScore = -1

	for _, Candidate in ipairs(Candidates) do

		local ConceptScore = SentenceSimilarity(
			Candidate.Sentence
		)

		local EmotionScore = EmotionSimilarity(
			Candidate.Emotion
		)

		local FinalScore =
			(ConceptScore * CONCEPT_WEIGHT) +
			(EmotionScore * EMOTION_WEIGHT)

		Candidate.ConceptScore = ConceptScore
		Candidate.EmotionScore = EmotionScore
		Candidate.FinalScore = FinalScore

		if FinalScore >= MINIMUM_SCORE
			and FinalScore > BestScore then

			BestScore = FinalScore
			BestCandidate = Candidate

		end

	end

	--------------------------------------------------
	-- NEURON FORGETTING
	-- REWRITE ONLY THE SELECTED STORED PATHWAY
	--------------------------------------------------

	if BestCandidate
		and BestCandidate.Owner
		and BestCandidate.OwnerKey then

		local Owner = BestCandidate.Owner
		local OwnerKey = BestCandidate.OwnerKey

		local OriginalDefinition = Owner[OwnerKey]

		if type(OriginalDefinition) == "string" then

			local EligibleWords = {}

			for word in OriginalDefinition:gmatch("[%w']+") do

				local alternatives = CloseMeanings[
				string.lower(word)
				]

				if type(alternatives) == "table"
					and #alternatives > 0 then

					table.insert(EligibleWords, word)

				end

			end

			-- Only occasionally forget a word.

			if #EligibleWords > 0
				and math.random() <= FORGET_RATE then

				local SelectedWord = EligibleWords[
				math.random(1, #EligibleWords)
				]

				local Alternatives = CloseMeanings[
				string.lower(SelectedWord)
				]

				local Replacement = Alternatives[
				math.random(1, #Alternatives)
				]

				if type(Replacement) == "string"
					and Replacement ~= "" then

					local Replaced = false

					local NewDefinition = OriginalDefinition:gsub(
						"[%w']+",
						function(word)

							if not Replaced
								and string.lower(word)
								== string.lower(SelectedWord) then

								Replaced = true

								return Replacement
							end

							return word

						end
					)

					if Replaced then

						Owner[OwnerKey] = NewDefinition

						print(
							"[ZINC FORGETTING]",
							OriginalDefinition,
							"->",
							NewDefinition
						)

					end
				end
			end
		end
	end

	--------------------------------------------------
	-- RETURN COMPLETE PATHWAY SENTENCE
	--------------------------------------------------

	if not BestCandidate then

		return "I don't know that.", 0, {
			Confidence = 0,
			MinimumScore = MINIMUM_SCORE
		}

	end

	local OutputSentence = BestCandidate.Sentence

	print("========== ZINC NEURON ==========")
	print("Input:", message)
	print("Response:", OutputSentence)
	print("Pathway:", BestCandidate.Source)
	print("Sentence Match:", BestCandidate.ConceptScore)
	print("Emotion Match:", BestCandidate.EmotionScore)
	print("Final Score:", BestCandidate.FinalScore)
	print("=================================")

	return OutputSentence, BestCandidate.FinalScore * 100, {

		Sentence = OutputSentence,

		Category = BestCandidate.Source,

		ConceptScore = BestCandidate.ConceptScore,

		EmotionScore = BestCandidate.EmotionScore,

		FinalScore = BestCandidate.FinalScore

	}

end


local function EmotionHandling(message)

	local EmotionPathways = Settings.EmotionPathways

	if type(EmotionPathways) ~= "table" then
		warn("Settings.EmotionPathways is missing!")
		return 0, 0, 0
	end

	message = string.lower(tostring(message))

	local BestMatch = nil
	local BestScore = 0

	local Emotions = {
		Anger = 0,
		Happy = 0,
		Sad = 0
	}

	-- Scan each emotion category
	for EmotionName, Pathways in pairs(EmotionPathways) do

		for _, Data in ipairs(Pathways) do

			local Phrase = string.lower(Data[1])

			-- Search for matching phrase
			if string.find(message, Phrase, 1, true) then

				-- Longer matches receive higher priority
				local Score = #Phrase

				if Score > BestScore then

					BestScore = Score
					BestMatch = Phrase

					Emotions.Anger = Data.Anger or 0
					Emotions.Happy = Data.Happy or 0
					Emotions.Sad = Data.Sad or 0

				end
			end
		end
	end

	print("========== EMOTION PREDICTION ==========")

	print("Input:", message)
	print("Matched:", BestMatch or "No match")

	print("Anger:", Emotions.Anger)
	print("Happy:", Emotions.Happy)
	print("Sad:", Emotions.Sad)

	print("========================================")

	NeuronFade(message, Emotions.Anger, Emotions.Happy, Emotions.Sad)
end


game.Players.LocalPlayer.Chatted:Connect(function(msg)
	EmotionHandling(msg)
end)
