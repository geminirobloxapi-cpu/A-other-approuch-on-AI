---------------------------------------------------------------------
-- STATE
---------------------------------------------------------------------

WorkingMemory.state = {

	lastUser = "",
	lastAI = "",

	topic = "",

	turnCount = 0,

	-------------------------------------------------------------
	-- Conversation history
	-------------------------------------------------------------

	history = {},

	-------------------------------------------------------------
	-- Important concepts currently active in thought
	-------------------------------------------------------------

	importantWords = {},

	-------------------------------------------------------------
	-- Word frequency within recent conversation
	-------------------------------------------------------------

	wordFrequency = {},

	-------------------------------------------------------------
	-- Topic strength
	-------------------------------------------------------------

	topics = {},

	-------------------------------------------------------------
	-- Current user message tokens
	-------------------------------------------------------------

	currentWords = {},

	-------------------------------------------------------------
	-- Context string that can be fed back into CoreMemory
	-------------------------------------------------------------

	contextText = ""
}

---------------------------------------------------------------------
-- NORMALIZE WORD
---------------------------------------------------------------------

local function normalizeWord(word)

	word =
		string.lower(
			tostring(word or "")
		)

	word =
		string.gsub(
			word,
			"^%p+",
			""
		)

	word =
		string.gsub(
			word,
			"%p+$",
			""
		)

	return word
end

---------------------------------------------------------------------
-- TOKENIZE
---------------------------------------------------------------------

local function tokenize(text)

	local words = {}

	text =
		string.lower(
			tostring(text or "")
		)

	for word in string.gmatch(
		text,
		"[%w_']+"
		) do

		word =
			normalizeWord(word)

		if word ~= "" then

			table.insert(
				words,
				word
			)

		end
	end

	return words
end

---------------------------------------------------------------------
-- GET CONTENT WORDS
---------------------------------------------------------------------

local function getContentWords(text)

	local words =
		tokenize(text)

	local results = {}

	for _, word in ipairs(words) do

		if not STOP_WORDS[word] then

			table.insert(
				results,
				word
			)

		end
	end

	return results
end

---------------------------------------------------------------------
-- ADD HISTORY
---------------------------------------------------------------------

local function addHistory(
	speaker,
	text
)

	table.insert(
		WorkingMemory.state.history,
		{
			speaker = speaker,
			text = text,
			time = os.time()
		}
	)

	while #WorkingMemory.state.history
		> MAX_HISTORY do

		table.remove(
			WorkingMemory.state.history,
			1
		)

	end
end

---------------------------------------------------------------------
-- RECALCULATE WORD FREQUENCY
---------------------------------------------------------------------

local function rebuildWordFrequency()

	local frequencies = {}

	for _, entry
		in ipairs(
			WorkingMemory.state.history
		) do

		local words =
			getContentWords(
				entry.text
			)

		for _, word
			in ipairs(words) do

			frequencies[word] =
				(frequencies[word] or 0)
				+ 1

		end
	end

	WorkingMemory.state.wordFrequency =
		frequencies
end

---------------------------------------------------------------------
-- UPDATE TOPICS
---------------------------------------------------------------------

local function updateTopics()

	local state =
		WorkingMemory.state

	local frequencies =
		state.wordFrequency

	local topicCandidates = {}

	for word, count
		in pairs(frequencies) do

		table.insert(
			topicCandidates,
			{
				word = word,
				score = count
			}
		)

	end

	table.sort(
		topicCandidates,

		function(a, b)

			if a.score == b.score then
				return a.word < b.word
			end

			return
				a.score
				>
			b.score

		end
	)

	state.topics = {}

	for i = 1,
		math.min(
			MAX_TOPIC_WORDS,
			#topicCandidates
		) do

		local candidate =
			topicCandidates[i]

		state.topics[
		candidate.word
		] =
			candidate.score
	end

	-------------------------------------------------------------
	-- Strongest topic
	-------------------------------------------------------------

	if topicCandidates[1] then

		state.topic =
			topicCandidates[1].word

	else

		state.topic =
			""
	end
end

---------------------------------------------------------------------
-- UPDATE IMPORTANT WORDS
---------------------------------------------------------------------

local function updateImportantWords()

	local state =
		WorkingMemory.state

	local results = {}

	for word, count
		in pairs(
			state.wordFrequency
		) do

		table.insert(
			results,
			{
				word = word,
				score = count
			}
		)

	end

	table.sort(
		results,

		function(a, b)

			return
				a.score
				>
			b.score

		end
	)

	state.importantWords = {}

	for i = 1,
		math.min(
			MAX_IMPORTANT_WORDS,
			#results
		) do

		table.insert(
			state.importantWords,
			results[i].word
		)

	end
end

---------------------------------------------------------------------
-- BUILD CONTEXT TEXT
---------------------------------------------------------------------

local function rebuildContextText()

	local state =
		WorkingMemory.state

	local pieces = {}

	-------------------------------------------------------------
	-- Main topic
	-------------------------------------------------------------

	if state.topic ~= "" then

		table.insert(
			pieces,
			state.topic
		)

	end

	-------------------------------------------------------------
	-- Important words
	-------------------------------------------------------------

	for _, word
		in ipairs(
			state.importantWords
		) do

		if word ~= state.topic then

			table.insert(
				pieces,
				word
			)

		end

		if #pieces >= 12 then
			break
		end
	end

	state.contextText =
		table.concat(
			pieces,
			" "
		)
end

---------------------------------------------------------------------
-- REBUILD ALL WORKING MEMORY
---------------------------------------------------------------------

local function rebuildState()

	rebuildWordFrequency()

	updateTopics()

	updateImportantWords()

	rebuildContextText()
end

---------------------------------------------------------------------
-- UPDATE USER MESSAGE
---------------------------------------------------------------------

function WorkingMemory.UpdateUser(text)

	text =
		tostring(text or "")

	local state =
		WorkingMemory.state

	state.lastUser =
		text

	state.turnCount += 1

	state.currentWords =
		getContentWords(text)

	addHistory(
		"user",
		text
	)

	rebuildState()
end

---------------------------------------------------------------------
-- UPDATE AI MESSAGE
---------------------------------------------------------------------

function WorkingMemory.UpdateAI(text)

	text =
		tostring(text or "")

	local state =
		WorkingMemory.state

	state.lastAI =
		text

	addHistory(
		"ai",
		text
	)

	rebuildState()
end

