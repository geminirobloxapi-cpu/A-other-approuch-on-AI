---------------------------------------------------------------------
-- GET TOPICS
---------------------------------------------------------------------

function WorkingMemory.GetTopics()

	local copy = {}

	for topic, strength
		in pairs(
			WorkingMemory.state.topics
		) do

		copy[topic] =
			strength

	end

	return copy
end

---------------------------------------------------------------------
-- GET CONTEXT TEXT
---------------------------------------------------------------------

function WorkingMemory.GetContextText()

	return
		WorkingMemory.state.contextText

end

---------------------------------------------------------------------
-- GET RECENT HISTORY
---------------------------------------------------------------------

function WorkingMemory.GetHistory(limit)

	limit =
		math.clamp(
			tonumber(limit)
			or MAX_HISTORY,

			1,
			MAX_HISTORY
		)

	local history =
		WorkingMemory.state.history

	local results = {}

	local startIndex =
		math.max(
			1,
			#history - limit + 1
		)

	for i = startIndex, #history do

		local entry =
			history[i]

		table.insert(
			results,
			{
				speaker =
					entry.speaker,

				text =
					entry.text,

				time =
					entry.time
			}
		)

	end

	return results
end

---------------------------------------------------------------------
-- FIND WORD IN RECENT MEMORY
---------------------------------------------------------------------

function WorkingMemory.HasRecentWord(word)

	word =
		normalizeWord(word)

	if word == "" then
		return false
	end

	return
		WorkingMemory.state.wordFrequency[word]
		~= nil
end

---------------------------------------------------------------------
-- GET WORD STRENGTH
---------------------------------------------------------------------

function WorkingMemory.GetWordStrength(word)

	word =
		normalizeWord(word)

	return
		WorkingMemory.state.wordFrequency[word]
		or 0
end

---------------------------------------------------------------------
-- RECALL RELATED RECENT MESSAGES
---------------------------------------------------------------------

function WorkingMemory.FindMessagesContaining(
	word,
	limit
)

	word =
		normalizeWord(word)

	limit =
		math.clamp(
			tonumber(limit)
			or 5,

			1,
			MAX_HISTORY
		)

	local results = {}

	if word == "" then
		return results
	end

	local history =
		WorkingMemory.state.history

	for i = #history, 1, -1 do

		local entry =
			history[i]

		local words =
			tokenize(
				entry.text
			)

		for _, foundWord
			in ipairs(words) do

			if foundWord == word then

				table.insert(
					results,
					{
						speaker =
							entry.speaker,

						text =
							entry.text,

						time =
							entry.time
					}
				)

				break
			end
		end

		if #results >= limit then
			break
		end
	end

	return results
end

---------------------------------------------------------------------
-- CREATE CONTEXT VECTOR INPUT TEXT
---------------------------------------------------------------------

-- This is useful with CoreMemoryControllerModule:
--
-- local context =
--     WorkingMemory.BuildBrainInput(userText)
--
-- local vec =
--     Dictionary.TextToVector(context)

function WorkingMemory.BuildBrainInput(
	currentMessage
)

	currentMessage =
		tostring(
			currentMessage
			or WorkingMemory.state.lastUser
			or ""
		)

	local pieces = {}

	-------------------------------------------------------------
	-- Current message is strongest.
	-------------------------------------------------------------

	if currentMessage ~= "" then

		table.insert(
			pieces,
			currentMessage
		)

		-- Repeat it once to give it more influence than old context.
		table.insert(
			pieces,
			currentMessage
		)

	end

	-------------------------------------------------------------
	-- Current conversation topic
	-------------------------------------------------------------

	local context =
		WorkingMemory.state.contextText

	if context ~= "" then

		table.insert(
			pieces,
			context
		)

	end

	-------------------------------------------------------------
	-- Last AI response gives continuity
	-------------------------------------------------------------

	if WorkingMemory.state.lastAI ~= "" then

		table.insert(
			pieces,
			WorkingMemory.state.lastAI
		)

	end

	return
		table.concat(
			pieces,
			" "
		)
end

---------------------------------------------------------------------
-- SOFT DECAY
---------------------------------------------------------------------

-- Slowly decreases the importance of older topics.
--
-- Call once per conversation turn if desired.

function WorkingMemory.Decay(
	amount
)

	amount =
		tonumber(amount)
		or 0.1

	amount =
		math.clamp(
			amount,
			0,
			1
		)

	local state =
		WorkingMemory.state

	for word, frequency
		in pairs(
			state.wordFrequency
		) do

		local newValue =
			frequency - amount

		if newValue <= 0 then

			state.wordFrequency[word] =
				nil

		else

			state.wordFrequency[word] =
				newValue

		end
	end

	updateTopics()

	updateImportantWords()

	rebuildContextText()
end

---------------------------------------------------------------------
-- CLEAR CURRENT CONVERSATION
---------------------------------------------------------------------

function WorkingMemory.Clear()

	WorkingMemory.state = {

		lastUser = "",
		lastAI = "",

		topic = "",

		turnCount = 0,

		history = {},

		importantWords = {},

		wordFrequency = {},

		topics = {},

		currentWords = {},

		contextText = ""
	}
end

