--------------------------------------------------------------------------------
-- 4. TOKENIZER & MUTATION ENGINE
--------------------------------------------------------------------------------
local function Tokenize(text: string): {string}
	local tokens = {}
	for word in string.gmatch(string.lower(text or ""), "%w+") do
		table.insert(tokens, word)
	end
	return tokens
end

-- Aggressively mutates text by replacing words with matching family synonyms
local function MutateDefinition(text: string): string
	local words = {}
	for word in string.gmatch(text, "%S+") do
		local cleanWord = string.lower(string.match(word, "%w+") or word)

		-- High probability (70%) of swapping to force noticeable synonym evolution
		if Synonyms[cleanWord] and math.random() <= 0.7 then
			local options = Synonyms[cleanWord]
			local newWord = options[math.random(1, #options)]
			word = string.gsub(word, cleanWord, newWord)
		end
		table.insert(words, word)
	end
	return table.concat(words, " ")
end

-- Decay connections immediately so words replace constantly
local function FastDecayNeurons()
	for _, pathway in pairs(Pathways) do
		if pathway.strength then
			pathway.strength = math.max(0.1, pathway.strength - SystemState.NeuronDecayRate)
		end
	end
end

--------------------------------------------------------------------------------
-- 5. PROCESS ZINC INPUT (MAIN INFERENCE ENGINE)
--------------------------------------------------------------------------------
local function ProcessZincInput(userInput: string): string
	local tokens = Tokenize(userInput)
	if #tokens == 0 then
		return "I didn't receive any text to process."
	end

	FastDecayNeurons()

	-- Check for feedback keywords
	local feedbackDetected = false
	for _, token in ipairs(tokens) do
		for _, kw in ipairs(FeedbackKeywords) do
			if token == kw then
				feedbackDetected = true
				break
			end
		end
		if feedbackDetected then break end
	end

	if feedbackDetected then
		SystemState.ThinkingLevel += 1
		SystemState.Confusion = math.min(SystemState.Confusion + 0.3, 2.0)
	else
		SystemState.Confusion = math.max(SystemState.Confusion - 0.1, 0.0)
	end

	-- Search concepts in pathways
	local matchedConcept = nil
	local matchedDef = nil
	local matchedPathway = nil

	for pName, pathway in pairs(Pathways) do
		if pathway.concepts then
			for conceptKey, def in pairs(pathway.concepts) do
				for _, token in ipairs(tokens) do
					if token == conceptKey then
						matchedConcept = conceptKey
						matchedDef = def
						matchedPathway = pathway
						break
					end
				end
				if matchedConcept then break end
			end
		end
		if matchedConcept then break end
	end

	if matchedConcept and matchedDef and matchedPathway then
		matchedPathway.lastActive = os.time()

		-- Mutate and re-save the new definition back into memory
		local newDef = MutateDefinition(matchedDef)
		matchedPathway.concepts[matchedConcept] = newDef
		matchedPathway.strength = 0.1 -- Drop back to force continuous mutation next query

		if matchedPathway == Pathways.Greetings then
			return newDef
		end

		return string.format("%s is %s.", matchedConcept:sub(1,1):upper()..matchedConcept:sub(2), newDef)
	end

	-- Calculate word mismatch & confusion
	local recognizedCount = 0
	for _, token in ipairs(tokens) do
		local known = false
		for _, p in pairs(Pathways) do
			if p.concepts and p.concepts[token] then known = true end
			if known then break end
		end
		if known then recognizedCount += 1 end
	end

	local mismatchRatio = 1 - (recognizedCount / math.max(#tokens, 1))
	SystemState.Confusion = math.min(SystemState.Confusion + mismatchRatio, 3.0)

	-- Dynamic learning mode without pre-programmed tags
	if SystemState.ThinkingLevel >= 1 and #tokens >= 3 then
		local newConcept = tokens[1]
		local newDef = table.concat(tokens, " ", 2)
		Pathways.DynamicLearned.concepts[newConcept] = newDef
		Pathways.DynamicLearned.strength = 0.1
		return string.format("I've learned that %s is %s.", newConcept, newDef)
	end

	return "I'm not completely sure about that yet, but I'm adapting."
end

